{
  "name": "js-plugin-ui",
  "type": "node",
  "main": "main.cjs",
  "node": {
    "backend": "embedded",
    "timeoutMs": 15000,
    "permissions": ["plugins", "plugin.org.example.sample_ui", "ui"]
  },
  "example": {
    "capabilities": ["plugins", "plugin.org.example.sample_ui", "ui"],
    "expectedProvider": "local JS-only plugin manager plus Activity-owned UI bridge",
    "packagedSupport": "supported only for already-packaged local plugin files",
    "securityLimitations": ["no plugin downloads", "native plugin archives denied", "UI handles stay opaque"]
  }
}
