{
  "name": "cpu-profile",
  "type": "node",
  "main": "main.cjs",
  "node": {
    "backend": "embedded",
    "timeoutMs": 10000,
    "permissions": []
  },
  "example": {
    "capabilities": ["profiler", "inspector"],
    "expectedProvider": "explicit debug-only inspector Profiler session",
    "packagedSupport": "not supported in release builds",
    "securityLimitations": ["release builds deny inspector", "no managed .cpuprofile artifact export", "profiles may expose source locations and runtime metadata"]
  }
}
