{
  "name": "heap-snapshot",
  "type": "node",
  "main": "main.cjs",
  "node": {
    "backend": "embedded",
    "timeoutMs": 10000,
    "permissions": []
  },
  "example": {
    "capabilities": ["heap-snapshot", "inspector"],
    "expectedProvider": "explicit debug-only inspector HeapProfiler session",
    "packagedSupport": "unavailable in release packaged apps",
    "securityLimitations": [
      "release builds deny inspector",
      "full snapshot export is not implemented",
      "heap data may contain secrets and must stay app-private until explicit export"
    ]
  }
}
