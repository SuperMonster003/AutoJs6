{
  "name": "inspector-debug",
  "type": "node",
  "main": "main.cjs",
  "node": {
    "backend": "embedded",
    "timeoutMs": 10000,
    "permissions": []
  },
  "example": {
    "capabilities": ["inspector"],
    "expectedProvider": "explicit debug-only localhost inspector facade",
