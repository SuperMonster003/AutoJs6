{
  "name": "long-running-service",
  "type": "node",
  "main": "main.cjs",
  "node": {
    "backend": "embedded",
    "timeoutMs": 15000,
    "executionMode": "interactive_long_running",
    "permissions": []
  },
  "example": {
    "capabilities": ["interactive_long_running", "lifecycle_checkpoint"],
    "expectedProvider": "explicit interactive long-running launch surface",
    "packagedSupport": "not supported; packaged entries remain one-shot",
    "securityLimitations": ["restart policy is never", "checkpoint data is JSON-only", "direct one-shot launch rejects service mode"]
  }
}
