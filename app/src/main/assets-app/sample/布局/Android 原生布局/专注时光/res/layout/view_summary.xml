<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_summary"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/space_medium">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            style="@style/FocusCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/session_label" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_tiny"
            android:text="@string/session_target"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/session_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/session_initial"
        android:textColor="@color/primary"
        android:textSize="@dimen/text_summary"
        android:textStyle="bold" />
</LinearLayout>
