<resources xmlns:tools="http://schemas.android.com/tools">

    <string name="css_style_license_dialog_notices" translatable="false">
        p.license {
            background: grey;
        }
        body {
            font-family: sans-serif;
            overflow-wrap: break-word;
        }
        body a:link {
            color: #00838F;
        }
        pre {
            background-color: #F2F2F2;
            padding: 1em;
            white-space: pre-wrap;
        }
    </string>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:actionMenuTextColor">@color/day_night</item>
        <item name="android:divider">@color/divider</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:itemBackground">@color/item_background</item>
        <item name="android:textColorPrimary">@color/text_color_primary</item>
        <item name="android:textColorSecondary">@color/text_color_secondary</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="drawer_group_text_color">@color/drawer_menu_group_text_color</item>
        <item name="drawer_item_text_color">@color/drawer_menu_item_text_color</item>
        <item name="itemBackgroundDark">@color/item_background_dark</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <item name="actionOverflowMenuStyle">@style/OverflowMenu</item>
    </style>

    <style name="ToolBarStyleRaw" parent="ThemeOverlay.AppCompat.DayNight.ActionBar">
        <item name="searchViewStyle">@style/SearchViewActionBar</item>
        <item name="titleMarginStart">0dp</item>
    </style>

    <style name="ToolBarStyle" parent="ThemeOverlay.AppCompat.DayNight.ActionBar">
        <item name="searchViewStyle">@style/SearchViewActionBar</item>
        <item name="android:textColorPrimary">@color/toolbar_text</item>
        <item name="android:textColorSecondary">@color/toolbar_text</item>
        <item name="actionMenuTextColor">@color/toolbar_text</item>
        <item name="titleMarginStart">0dp</item>
        <item name="iconTint">@color/toolbar_text</item>
        <item name="popupTheme">@style/PopupMenuTheme</item>
    </style>

    <style name="ToolBarStyleInrt" parent="ToolBarStyle">
        <item name="colorControlNormal">@color/md_black_1000</item>
    </style>

    <style name="AppTheme.NoActionBarInrt" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">@color/md_blue_gray_50</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorPrimary">@color/md_blue_gray_50</item>
        <item name="colorPrimaryDark">@color/md_blue_gray_50</item>
        <item name="colorAccent">@color/md_black_1000</item>
    </style>

    <style name="EditorTheme" parent="AppTheme">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:actionModeBackground">@color/colorAccent</item>
    </style>

    <style name="AppTheme.FullScreen" parent="AppTheme">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="AppTheme.Splash" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@color/window_background</item>
        <item name="android:navigationBarColor">@color/window_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="AppTheme.Settings" parent="AppTheme">
        <item name="android:dividerHeight">0dp</item>
        <item name="android:listDivider">@color/divider_app_settings_list</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:textColorPrimary">@color/prefTextColorPrimary</item>
        <item name="android:textColorSecondary">@color/prefTextColorSecondary</item>
    </style>

    <style name="AppTheme.Transparent" parent="AppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="AppTheme.SevereTransparent" parent="AppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.DayNight.ActionBar">
        <item name="actionOverflowMenuStyle">@style/OverflowMenu</item>
    </style>

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.DayNight.ActionBar">
        <item name="android:textColorPrimary">@color/day_full</item>
        <item name="android:textColorSecondary">@color/day_full</item>
        <item name="actionOverflowMenuStyle">@style/OverflowMenu</item>
    </style>

    <style name="MtAppTheme.FullScreen" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="MtAppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.DayNight.ActionBar">
        <item name="actionOverflowMenuStyle">@style/OverflowMenu</item>
    </style>

    <style name="MtAppTheme.PopupOverlay" parent="OverflowMenu">
        <item name="android:textColor">@color/day_night_full</item>
        <item name="android:tint">@color/day_night_full</item>
    </style>

    <style name="ConsoleTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorButtonNormal">#cc181818</item>
    </style>

    <style name="ConsoleSettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="ConsoleSettingsRowTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/day_night</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="ConsoleSettingsRowSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/day_night_alpha_60</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ScriptTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:popupTheme" tools:ignore="NewApi">@style/ScriptTheme.PopupOverlay</item>
    </style>

    <style name="ScriptTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="ScriptTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="ScriptTheme.Transparent" parent="ScriptTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="PopupMenuTheme" parent="AppTheme.PopupOverlay">
        <item name="android:textColor">@color/day_night_full</item>
        <item name="android:tint">@color/day_night_full</item>
    </style>

    <style name="PopupMenuThemeLight" parent="AppTheme.PopupOverlay">
        <item name="android:textColor">@color/day_full</item>
        <item name="android:tint">@color/day_full</item>
    </style>

    <style name="PopupMenuThemeDark" parent="AppTheme.PopupOverlay">
        <item name="android:textColor">@color/night_full</item>
        <item name="android:tint">@color/night_full</item>
    </style>

    <style name="EditorPopupMenuTheme" parent="ThemeOverlay.AppCompat.DayNight.ActionBar">
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textColorPrimary">@android:color/black</item>
        <item name="android:textColorSecondary">@android:color/black</item>
        <item name="colorControlNormal">@android:color/black</item>
        <item name="actionOverflowMenuStyle">@style/EditorOverflowMenu</item>
        <!-- PopupMenu (dialog options menus of EditorMaterialDialogThemeDelegate) reads popupMenuStyle, not the overflow style. -->
        <!-- zh-CN: PopupMenu (EditorMaterialDialogThemeDelegate 中对话框的选项菜单) 读取的是 popupMenuStyle, 而非溢出菜单样式. -->
        <item name="popupMenuStyle">@style/EditorPopupMenu</item>
        <item name="listMenuViewStyle">@style/EditorListMenuView</item>
        <item name="android:checkboxStyle">@style/EditorPopupCheckbox</item>
        <item name="android:radioButtonStyle">@style/EditorPopupRadioButton</item>
    </style>

    <style name="EditorOverflowMenu" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/editor_popup_background</item>
        <item name="android:itemBackground">@drawable/editor_popup_item_background</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="overlapAnchor">false</item>
        <item name="android:dropDownVerticalOffset">5dp</item>
    </style>

    <style name="EditorPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/editor_popup_background</item>
    </style>

    <style name="EditorListMenuView" parent="Widget.AppCompat.ListMenuView">
        <item name="android:itemBackground">@drawable/editor_popup_item_background</item>
        <item name="subMenuArrow">@drawable/editor_popup_submenu_arrow</item>
    </style>

    <style name="EditorPopupCheckbox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:button">@drawable/editor_popup_checkbox</item>
        <item name="android:buttonTint">@null</item>
    </style>

    <style name="EditorPopupRadioButton" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:button">@drawable/editor_popup_radio</item>
        <item name="android:buttonTint">@null</item>
    </style>

    <style name="PopupMenu.HideIndicator" parent="@style/ThemeOverlay.AppCompat.DayNight">
        <item name="android:radioButtonStyle">@style/PopupMenu.Radio.Null</item>
        <item name="android:checkboxStyle">@style/PopupMenu.Radio.Null</item>
        <item name="android:textColor">@color/day_night</item>
    </style>

    <style name="PopupMenu.Radio.Null" parent="@style/Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:button">@null</item>
    </style>

    <style name="SearchViewActionBar" parent="@style/Widget.AppCompat.SearchView.ActionBar" />

    <style name="Material3DarkTheme" parent="@style/Theme.Material3.Dark" />

    <style name="Material3LightTheme" parent="@style/Theme.Material3.Light" />

    <style name="TextAppearanceEditorTitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">@dimen/editor_title_text_size</item>
        <item name="maxLines">2</item>
        <item name="paddingStart">0dp</item>
    </style>

    <style name="TextAppearanceDefaultMainTitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">@dimen/main_title_text_size</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TextAppearanceHorizontalWithSubtitleMainTitle" parent="TextAppearanceDefaultMainTitle">
        <item name="android:textSize">@dimen/main_title_text_size_horizontal_with_subtitle</item>
    </style>

    <style name="TextAppearanceMainSubtitle" parent="TextAppearanceDefaultMainTitle">
        <item name="android:textSize">@dimen/main_subtitle_text_size</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">middle</item>
    </style>

    <style name="OverflowIconDarkTheme" parent="@style/Widget.AppCompat.ActionButton.Overflow">
        <item name="android:tint">@color/md_white_1000</item>
    </style>

    <style name="OverflowMenu" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:textColor">@color/day_night_full</item>
        <item name="android:itemBackground">@color/item_background</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="overlapAnchor">false</item>
        <item name="android:dropDownVerticalOffset">5.0dp</item>
    </style>

    <style name="OverflowMenuInrt" parent="OverflowMenu">
        <item name="android:textColor">@color/md_black_1000</item>
        <item name="android:popupBackground">@color/md_blue_gray_50</item>
        <item name="android:itemBackground">@color/md_blue_gray_50</item>
    </style>

    <!-- Icon-only buttons in the section headers of the accessibility service manager dialog. -->
    <!-- zh-CN: 无障碍服务管理器对话框区块标题中的纯图标按钮. -->
    <style name="A11yServiceManagerHeaderButton">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- Section titles, check boxes and number inputs of the layout inspector filter profile dialog (roadmap P3.2). -->
    <!-- zh-CN: 布局分析筛选配置对话框的区块标题, 复选框与数字输入框 (Roadmap P3.2). -->
    <style name="LayoutInspectorFilterSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:textColor">@color/day_night_alpha_60</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="LayoutInspectorFilterCheck">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:textColor">@color/day_night</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="LayoutInspectorFilterNumber">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">7</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/day_night</item>
        <item name="android:textColorHint">@color/day_night_alpha_40</item>
        <item name="android:textSize">13sp</item>
    </style>

</resources>
