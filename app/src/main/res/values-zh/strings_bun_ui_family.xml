<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="summary_bun_floaty_control_grant">允许在其他应用上层显示悬浮窗, 并查询或申请悬浮窗权限; 原始悬浮窗与触摸穿透需要各自的授权.</string>
    <string name="summary_bun_floaty_raw_grant">允许显示没有可调整外框的原始悬浮窗; 不被悬浮窗授权隐含.</string>
    <string name="summary_bun_floaty_touch_grant">允许悬浮窗让触摸穿透到下层应用; 不被悬浮窗授权隐含.</string>
    <string name="summary_bun_terminal_control_grant">允许打开与控制终端插件的会话并在其中执行命令; 不被 Shell 授权隐含.</string>
    <string name="text_bun_floaty_control_grant">Bun 悬浮窗</string>
    <string name="text_bun_floaty_raw_grant">Bun 原始悬浮窗</string>
    <string name="text_bun_floaty_touch_grant">Bun 触摸穿透悬浮窗</string>
    <string name="text_bun_terminal_control_grant">Bun 终端会话</string>
</resources>
