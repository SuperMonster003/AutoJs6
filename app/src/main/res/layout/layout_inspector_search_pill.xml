<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed state of the inspector search bar: a draggable pill showing the match count (roadmap D9). -->
<!-- zh-CN: 搜索栏的收起态: 可拖动的浮标, 显示匹配计数 (Roadmap D9). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/pill"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@drawable/layout_inspector_search_surface"
        android:clickable="true"
        android:contentDescription="@string/text_inspector_expand_search_bar"
        android:elevation="4dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="12dp">

    <ImageView
            android:id="@+id/pill_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_search_black_48dp"
            android:tint="@color/day_night" />

    <TextView
            android:id="@+id/pill_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/day_night"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="17"
            tools:visibility="visible" />

</LinearLayout>
