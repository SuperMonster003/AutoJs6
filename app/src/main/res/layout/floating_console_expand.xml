<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <org.autojs.autojs.core.console.FloatingConsoleView
            android:id="@+id/console"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    <!-- Resize mode: dims the content below the title bar; the title bar stays draggable. -->
    <!-- zh-CN: 尺寸调整模式: 遮罩标题栏以下的内容区; 标题栏仍可拖动. -->

    <FrameLayout
            android:id="@+id/resize_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/console_title_bar_height"
            android:background="@drawable/floating_console_resize_overlay_bg"
            android:clickable="true"
            android:focusable="false"
            android:visibility="gone"
            tools:visibility="visible">

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

            <TextView
                    android:id="@+id/resize_size_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="1080 x 720" />

            <TextView
                    android:id="@+id/resize_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/text_console_resize_mode_hint"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp" />

        </LinearLayout>

        <View
                android:id="@+id/resize_edge_end"
                android:layout_width="@dimen/console_resize_edge_width"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="#55FFFFFF" />

        <View
                android:id="@+id/resize_edge_bottom"
                android:layout_width="match_parent"
                android:layout_height="@dimen/console_resize_edge_width"
                android:layout_gravity="bottom"
                android:background="#55FFFFFF" />

        <ImageView
                android:id="@+id/resize_grip"
                android:layout_width="@dimen/console_resize_grip_size"
                android:layout_height="@dimen/console_resize_grip_size"
                android:layout_gravity="bottom|end"
                android:layout_margin="6dp"
                android:background="@drawable/circle_cool_black"
                android:contentDescription="@string/text_resize"
                android:padding="8dp"
                android:scaleType="fitXY"
                android:src="@drawable/ic_resizer"
                app:tint="@android:color/white" />

    </FrameLayout>

</FrameLayout>
