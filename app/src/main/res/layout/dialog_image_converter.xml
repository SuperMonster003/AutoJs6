<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/apk_info_format"
            android:textColor="@color/day_night"
            android:textSize="15sp" />

        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/format"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:spinnerMode="dropdown" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/quality_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/text_image_conversion_quality"
                android:textColor="@color/day_night"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/quality_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_color_secondary"
                android:textSize="14sp"
                tools:text="92" />

        </LinearLayout>

        <org.autojs.autojs.theme.widget.ThemeColorSeekBar
            android:id="@+id/quality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="99"
            tools:progress="91" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/text_image_conversion_resize"
            android:textColor="@color/day_night"
            android:textSize="15sp" />

        <RadioGroup
            android:id="@+id/resize_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <org.autojs.autojs.theme.widget.ThemeColorRadioButton
                android:id="@+id/resize_original"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/text_image_conversion_original_size" />

            <org.autojs.autojs.theme.widget.ThemeColorRadioButton
                android:id="@+id/resize_percentage"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/text_image_conversion_percentage" />

            <org.autojs.autojs.theme.widget.ThemeColorRadioButton
                android:id="@+id/resize_custom"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/text_image_conversion_custom_size" />

        </RadioGroup>

        <org.autojs.autojs.theme.widget.ThemeColorTextInputLayout
            android:id="@+id/percentage_parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/text_image_conversion_percentage_hint"
            android:visibility="gone"
            app:expandedHintEnabled="false"
            app:suffixText="%">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/percentage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="4"
                android:text="100"
                android:textColor="@color/text_color_primary" />

        </org.autojs.autojs.theme.widget.ThemeColorTextInputLayout>

        <LinearLayout
            android:id="@+id/custom_size_parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <org.autojs.autojs.theme.widget.ThemeColorTextInputLayout
                    android:id="@+id/width_parent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/text_image_conversion_width"
                    app:expandedHintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/width"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="5"
                        android:textColor="@color/text_color_primary" />

                </org.autojs.autojs.theme.widget.ThemeColorTextInputLayout>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <org.autojs.autojs.theme.widget.ThemeColorTextInputLayout
                    android:id="@+id/height_parent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/text_image_conversion_height"
                    app:expandedHintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/height"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="5"
                        android:textColor="@color/text_color_primary" />

                </org.autojs.autojs.theme.widget.ThemeColorTextInputLayout>

            </LinearLayout>

            <org.autojs.autojs.theme.widget.ThemeColorCheckBox
                android:id="@+id/lock_aspect_ratio"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:checked="true"
                android:text="@string/text_image_conversion_lock_aspect_ratio" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/jpeg_background_parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_image_conversion_jpeg_background"
                android:textColor="@color/day_night"
                android:textSize="15sp" />

            <RadioGroup
                android:id="@+id/jpeg_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <org.autojs.autojs.theme.widget.ThemeColorRadioButton
                    android:id="@+id/jpeg_background_white"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/text_image_conversion_background_white" />

                <org.autojs.autojs.theme.widget.ThemeColorRadioButton
                    android:id="@+id/jpeg_background_black"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/text_image_conversion_background_black" />

            </RadioGroup>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="@color/divider_lighter_night_day" />

        <TextView
            android:id="@+id/output_resolution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/day_night"
            android:textSize="14sp"
            tools:text="Output: 1920 x 1080" />

        <TextView
            android:id="@+id/output_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/day_night"
            android:textSize="14sp"
            tools:text="Estimated file size: ~1.2 MiB" />

        <TextView
            android:id="@+id/output_filename"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="middle"
            android:maxLines="2"
            android:textColor="@color/day_night"
            android:textSize="14sp"
            tools:text="Output: photo_converted.jpg" />

        <TextView
            android:id="@+id/validation_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/console_view_error"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="The output image is too large"
            tools:visibility="visible" />

    </LinearLayout>

</ScrollView>
