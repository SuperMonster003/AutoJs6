<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp">

    <TextView
        android:id="@+id/settings_password_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp"
        android:textColor="@color/text_color_secondary"
        android:textSize="14sp"
        tools:text="@string/settings_transfer_password_export_hint" />

    <org.autojs.autojs.theme.widget.ThemeColorTextInputLayout
        android:id="@+id/settings_password_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/settings_transfer_password"
        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/settings_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:textColor="@color/text_color_primary" />

    </org.autojs.autojs.theme.widget.ThemeColorTextInputLayout>

    <org.autojs.autojs.theme.widget.ThemeColorTextInputLayout
        android:id="@+id/settings_password_confirm_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/settings_transfer_password_confirm"
        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/settings_password_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:textColor="@color/text_color_primary" />

    </org.autojs.autojs.theme.widget.ThemeColorTextInputLayout>

</LinearLayout>
