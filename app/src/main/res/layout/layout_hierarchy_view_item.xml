<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:padding="5dp">

    <!-- Indent only (its width is set per level by the adapter); the former level beams are gone. zh-CN: 仅缩进 (宽度由适配器按层级设置); 原来的层级竖线已去除. -->
    <Space
            android:id="@+id/dataItemIndent"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_centerVertical="true" />

    <!-- Collapsed (chevron right), expanded (chevron down) or leaf (hollow circle). zh-CN: 已收起 (右箭头), 已展开 (下箭头) 或无子孙 (空心圆). -->
    <ImageView
            android:id="@+id/dataItemIcon"
            android:layout_width="@dimen/layout_hierarchy_view_row_icon_size"
            android:layout_height="@dimen/layout_hierarchy_view_row_icon_size"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/layout_hierarchy_view_row_icon_margin_end"
            android:layout_toEndOf="@id/dataItemIndent"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_hierarchy_leaf"
            app:tint="@color/layout_hierarchy_view_row_icon" />

    <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_toEndOf="@id/dataItemIcon"
            android:gravity="start|center_vertical"
            android:orientation="vertical">

        <TextView
                android:id="@+id/dataItemName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/day_night"
                android:textSize="14sp"
                tools:text="TextView" />

        <TextView
                android:id="@+id/dataItemInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/day_night"
                android:textSize="12sp"
                android:visibility="gone" />
    </LinearLayout>

</RelativeLayout>
