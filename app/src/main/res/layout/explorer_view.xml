<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/explorer_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Matches explorer_category.xml: 13sp text with 8dp top and bottom padding. -->
        <LinearLayout
            android:id="@+id/explorer_path_row"
            android:layout_width="match_parent"
            android:layout_height="33.5dp"
            android:orientation="horizontal">

            <org.autojs.autojs.ui.explorer.ExplorerPathBar
                android:id="@+id/explorer_path_bar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:layoutDirection="ltr"
                android:paddingHorizontal="8dp" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/archive_filename_encoding"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/text_file_encoding"
                android:padding="7dp"
                android:src="@drawable/ic_translate_black_48dp"
                android:visibility="gone"
                app:tint="@color/explorer_category_operation_button"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/archive_create_directory"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/text_new_folder"
                android:padding="7dp"
                android:src="@drawable/ic_floating_action_menu_dir"
                android:visibility="gone"
                app:tint="@color/explorer_category_operation_button"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/archive_add_entries"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/text_add_files_or_folders"
                android:padding="7dp"
                android:src="@drawable/ic_add_black_48dp"
                android:visibility="gone"
                app:tint="@color/explorer_category_operation_button"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/archive_extract_current"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/text_extract_archive_current_folder"
                android:padding="7dp"
                android:src="@drawable/ic_unarchive_black_48dp"
                android:visibility="gone"
                app:tint="@color/explorer_category_operation_button"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/explorer_path_more"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/text_explorer_path_menu"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_more_explorer_btn"
                app:tint="@color/explorer_file_operation_button" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:background="?android:divider" />

        <TextView
            android:id="@+id/explorer_access_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="@string/text_explorer_privileged_access"
            android:textColor="?android:textColorSecondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <org.autojs.autojs.ui.explorer.ExplorerProjectToolbar
            android:id="@+id/project_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="2dp"
            android:foreground="?selectableItemBackground"
            app:cardElevation="0.97dp"
            app:cardUseCompatPadding="true" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.ThemeColorRecyclerView
                android:id="@+id/explorer_item_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false" />

            <LinearLayout
                android:id="@+id/explorer_access_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/explorer_access_error_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/explorer_access_retry"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/text_refresh" />

                <Button
                    android:id="@+id/explorer_access_settings"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_explorer_access_options" />

            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/selection_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:importantForAccessibility="no"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/selection_count"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:accessibilityLiveRegion="polite"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:textSize="13sp"
            tools:text="3 selected" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/day_night_alpha_20" />

        <LinearLayout
            android:id="@+id/selection_actions"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/selection_close"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/text_clear_file_selection"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="2dp"
                android:paddingVertical="5dp">

                <ImageView
                    android:id="@+id/selection_close_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="2dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_close_black_24dp"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/selection_close_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:text="@string/text_exit"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- Primary actions are inserted here by ExplorerSelectionToolbarController;
                 "More" lists the secondary actions and those without a free slot. -->

            <LinearLayout
                android:id="@+id/selection_more"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/text_more"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="2dp"
                android:paddingVertical="5dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/selection_more_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="2dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_more_vert_24dp"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/selection_more_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:text="@string/text_more"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
