<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/editor_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:theme="@style/AppTheme.AppBarOverlay">

        <org.autojs.autojs.theme.widget.ThemeColorToolbarEditor
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:theme="@style/ToolBarStyle"
            app:contentInsetEndWithActions="2dp"
            app:contentInsetStartWithNavigation="0dp"
            app:popupTheme="@style/EditorPopupMenuTheme"
            app:titleTextAppearance="@style/TextAppearanceEditorTitle"
            tools:title="@string/app_name">

            <FrameLayout
                android:id="@+id/toolbar_menu"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end" />

        </org.autojs.autojs.theme.widget.ThemeColorToolbarEditor>

        <LinearLayout
            android:id="@+id/editor_status_bar"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:background="@color/window_background"
            android:gravity="center_vertical"
            android:layoutDirection="ltr"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/editor_file_name_status"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?selectableItemBackgroundBorderless"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="start|center_vertical"
                android:includeFontPadding="false"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:textColor="@color/day_night_full"
                android:textSize="12sp"
                tools:text="test-basic-typescript" />

            <TextView
                android:id="@+id/editor_cursor_status"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="44dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="@color/day_night_full"
                android:textDirection="ltr"
                android:textSize="12sp"
                tools:text="10:2" />

            <TextView
                android:id="@+id/editor_encoding_status"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/text_file_encoding"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="56dp"
                android:paddingStart="6dp"
                android:paddingEnd="10dp"
                android:textColor="@color/day_night_full"
                android:textDirection="ltr"
                android:textSize="12sp"
                tools:text="UTF-8" />

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- The editor, and the layout preview panel of "ui" scripts beside or below it (EditorUiPreviewController). -->
            <LinearLayout
                android:id="@+id/editor_split"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/editor_container"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

            </LinearLayout>

            <TextView
                android:id="@+id/font_preview_unavailable_hint"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:ellipsize="end"
                android:gravity="center"
                android:importantForAccessibility="yes"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:text="@string/text_ace_editor_font_download_required_for_preview"
                android:textSize="13sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <FrameLayout
                android:id="@+id/input_method_enhance_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#77f2f3f7">

                <FrameLayout
                    android:id="@+id/input_method_enhance_bar_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/native_input_method_enhance_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/code_completion_row"
                            android:layout_width="match_parent"
                            android:layout_height="35dp">

                            <ImageView
                                android:id="@+id/functions"
                                android:layout_width="40dp"
                                android:layout_height="35dp"
                                android:background="?selectableItemBackgroundBorderless"
                                android:contentDescription="@string/text_function"
                                android:padding="6dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_ali_fx"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:tint="#222329" />

                            <org.autojs.autojs.ui.edit.completion.CodeCompletionBar
                                android:id="@+id/code_completion_bar"
                                android:layout_width="0dp"
                                android:layout_height="35dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/functions"
                                app:layout_constraintTop_toTopOf="parent" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <org.autojs.autojs.ui.edit.completion.CodeCompletionBar
                            android:id="@+id/symbol_bar"
                            android:layout_width="match_parent"
                            android:layout_height="35dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ace_input_method_enhance_content"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/ace_shortcut_panel"
                            android:layout_width="160dp"
                            android:layout_height="70dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="160dp"
                                android:layout_height="35dp"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/ace_functions"
                                    android:layout_width="40dp"
                                    android:layout_height="35dp"
                                    android:background="?selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/text_function"
                                    android:padding="6dp"
                                    android:scaleType="centerInside"
                                    android:src="@drawable/ic_ali_fx"
                                    app:tint="#222329" />

                                <org.autojs.autojs.ui.edit.completion.CodeCompletionBar
                                    android:id="@+id/ace_shortcut_top_bar"
                                    android:layout_width="120dp"
                                    android:layout_height="35dp" />

                            </LinearLayout>

                            <org.autojs.autojs.ui.edit.completion.CodeCompletionBar
                                android:id="@+id/ace_shortcut_bottom_bar"
                                android:layout_width="160dp"
                                android:layout_height="35dp" />

                        </LinearLayout>

                        <org.autojs.autojs.ui.edit.completion.CodeCompletionBar
                            android:id="@+id/ace_symbols_bar"
                            android:layout_width="0dp"
                            android:layout_height="70dp"
                            android:layout_weight="1" />

                    </LinearLayout>

                </FrameLayout>

                <FrameLayout
                    android:id="@+id/loading_bar_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="false"
                    android:focusable="false"
                    android:minHeight="35dp"
                    android:visibility="gone"
                    tools:background="#A0000000"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/loading_bar_text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/night_full"
                        android:textSize="14sp"
                        tools:text="@string/text_loading_with_dots" />

                </FrameLayout>

            </FrameLayout>

            <org.autojs.autojs.ui.edit.keyboard.FunctionsKeyboardView
                android:id="@+id/functions_keyboard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/theme_preview_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:visibility="gone"
                tools:visibility="visible">

                <me.zhanghai.android.materialprogressbar.MaterialProgressBar
                    android:id="@+id/font_preview_progress"
                    style="@style/Widget.MaterialProgressBar.ProgressBar.Horizontal.NoPadding"
                    android:layout_width="match_parent"
                    android:layout_height="1.5dp"
                    android:indeterminate="false"
                    android:max="1000"
                    android:visibility="invisible"
                    app:mpb_progressStyle="horizontal"
                    app:mpb_setBothDrawables="true"
                    app:mpb_useIntrinsicPadding="false"
                    tools:progress="580"
                    tools:visibility="visible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/theme_preview_title"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:singleLine="true"
                        android:textSize="14sp"
                        tools:text="Crimson Editor" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/font_preview_info"
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:gravity="center"
                    android:importantForAccessibility="yes"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/font_preview_info_type"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end|center_vertical"
                        android:importantForAccessibility="no"
                        android:paddingEnd="4dp"
                        android:singleLine="true"
                        android:textSize="12sp"
                        tools:text="@string/text_ace_editor_font_built_in" />

                    <TextView
                        android:id="@+id/font_preview_info_separator"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:singleLine="true"
                        android:text="@string/symbol_middle_dot"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/font_preview_info_size"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="start|center_vertical"
                        android:importantForAccessibility="no"
                        android:paddingStart="4dp"
                        android:singleLine="true"
                        android:textSize="12sp"
                        tools:text="1.53 MiB" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/theme_preview_list"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="?selectableItemBackgroundBorderless"
                        android:contentDescription="@string/text_theme_preview_list"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_list" />

                    <ImageView
                        android:id="@+id/theme_preview_filter"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="?selectableItemBackgroundBorderless"
                        android:contentDescription="@string/text_theme_preview_filter_all"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_day_and_night" />

                    <ImageView
                        android:id="@+id/theme_preview_previous"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="?selectableItemBackgroundBorderless"
                        android:contentDescription="@string/text_theme_preview_previous"
                        android:padding="6dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_skip_previous_black_48dp" />

                    <TextView
                        android:id="@+id/theme_preview_index"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:singleLine="true"
                        android:textSize="13sp"
                        tools:text="12/48" />

                    <ImageView
                        android:id="@+id/theme_preview_next"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="?selectableItemBackgroundBorderless"
                        android:contentDescription="@string/text_theme_preview_next"
                        android:padding="6dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_skip_next_black_48dp" />

                    <ImageView
                        android:id="@+id/theme_preview_exit"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="?selectableItemBackgroundBorderless"
                        android:contentDescription="@string/text_theme_preview_exit"
                        android:padding="6dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_close_black_48dp" />

                    <ImageView
                        android:id="@+id/theme_preview_use"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="?selectableItemBackgroundBorderless"
                        android:contentDescription="@string/text_theme_preview_use"
                        android:padding="7dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/mt_ic_check_white_36dp" />

                </LinearLayout>

            </LinearLayout>

            <org.autojs.autojs.ui.edit.debug.DebugBar
                android:id="@+id/debug_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="start">

            <org.autojs.autojs.ui.widget.EWebView
                android:id="@+id/docs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:saveEnabled="false" />

            <include layout="@layout/view_offline_docs_unavailable" />

        </FrameLayout>

    </androidx.drawerlayout.widget.DrawerLayout>

</LinearLayout>
