<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory
        app:layout="@layout/preference_category_custom"
        app:title="@string/text_script_modules">

        <org.autojs.autojs.theme.preference.ThemeColorSwitchPreference
            app:key="@string/key_new_script_module_layer"
            app:layout="@layout/preference_custom"
            app:defaultValue="false"
            app:summary="@string/summary_new_script_module_layer"
            app:title="@string/text_new_script_module_layer" />

        <org.autojs.autojs.theme.preference.ThemeColorSwitchPreference
            app:key="@string/key_script_module_debug_print"
            app:layout="@layout/preference_custom"
            app:defaultValue="false"
            app:summary="@string/summary_script_module_debug_print"
            app:title="@string/text_script_module_debug_print" />

        <org.autojs.autojs.ui.settings.ScriptModuleDebugPrintModulesPreference
            app:key="@string/key_script_module_debug_print_disabled_modules"
            app:layout="@layout/preference_custom"
            app:dependency="@string/key_script_module_debug_print"
            app:persistent="false"
            app:title="@string/text_script_module_debug_print_modules" />

    </org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory>

    <org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory
        app:layout="@layout/preference_category_custom"
        app:title="@string/text_updates">

        <org.autojs.autojs.ui.settings.ClearUpdatesCheckedStatesPreference
            app:key="@string/key_updates_checked_states_cleared"
            app:layout="@layout/preference_custom"
            app:summary="@string/text_clear_updates_checked_states_description"
            app:title="@string/text_clear_updates_checked_states" />

        <org.autojs.autojs.ui.settings.CheckForUpdatesWithLocalVersionIgnoredPreference
            app:key="@string/key_check_for_updates_while_ignoring_the_local_version"
            app:layout="@layout/preference_custom"
            app:summary="@string/text_check_for_updates_while_ignoring_the_local_version_description"
            app:title="@string/text_check_for_updates_while_ignoring_the_local_version" />

    </org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory>

    <org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory
        app:layout="@layout/preference_category_custom"
        app:title="@string/text_github">

        <org.autojs.autojs.ui.settings.GitHubTokenPreference
            app:key="@string/key_github_token"
            app:layout="@layout/preference_custom"
            app:summary="@string/summary_github_token_not_set"
            app:title="@string/text_github_token"
            app:longClickPrompt="@string/description_github_token_preference" />

    </org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory>

    <org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory
        app:layout="@layout/preference_category_custom"
        app:title="@string/text_ai">

        <org.autojs.autojs.ui.settings.AiSettingsPreference
            app:key="@string/key_ai_settings"
            app:layout="@layout/preference_custom"
            app:summary="@string/description_ai_settings_preference"
            app:title="@string/text_ai_settings"
            app:longClickPrompt="@string/description_ai_settings_preference" />

    </org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory>

    <org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory
        app:layout="@layout/preference_category_custom"
        app:title="@string/text_mail">

        <org.autojs.autojs.ui.settings.MailSettingsPreference
            app:key="@string/key_mail_settings"
            app:layout="@layout/preference_custom"
            app:summary="@string/description_mail_settings_preference"
            app:title="@string/text_mail_settings"
            app:longClickPrompt="@string/description_mail_settings_preference" />

    </org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory>

    <org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory
        app:layout="@layout/preference_category_custom"
        app:title="@string/text_dex_compiler">

        <org.autojs.autojs.ui.settings.DexCompilerPreference
            app:layout="@layout/preference_custom"
            app:longClickPrompt="@string/description_dex_compiler_experimental_preference"
            app:summary="@string/summary_dex_compiler_experimental_disabled"
            app:title="@string/text_dex_compiler_provider" />

    </org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory>

    <org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory
        app:layout="@layout/preference_category_custom"
        app:title="@string/text_r8_compiler">

        <org.autojs.autojs.ui.settings.R8CompilerPreference
            app:layout="@layout/preference_custom"
            app:longClickPrompt="@string/description_r8_compiler_explicit_preference"
            app:summary="@string/summary_r8_compiler_explicit_disabled"
            app:title="@string/text_r8_compiler_provider" />

    </org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory>

    <org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory
        app:layout="@layout/preference_category_custom"
        app:title="@string/text_nodejs">

        <org.autojs.autojs.theme.preference.ThemeColorSwitchPreference
            app:key="@string/key_nodejs_inspector_enabled"
            app:layout="@layout/preference_custom"
            app:defaultValue="false"
            app:summary="@string/summary_nodejs_inspector_enabled"
            app:title="@string/text_nodejs_inspector_enabled" />

        <org.autojs.autojs.ui.settings.NodeDoctorReportPreference
            app:key="@string/key_nodejs_doctor_report"
            app:layout="@layout/preference_custom"
            app:summary="@string/summary_nodejs_doctor_report"
            app:title="@string/text_nodejs_doctor"
            app:longClickPrompt="@string/description_nodejs_doctor_report_preference" />

    </org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory>

    <org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory
        app:layout="@layout/preference_category_custom"
        app:title="@string/text_setup_wizards">

        <org.autojs.autojs.ui.settings.ResetSetupWizardWelcomePreference
            app:layout="@layout/preference_custom"
            app:summary="@string/summary_setup_wizard_welcome_reset"
            app:title="@string/text_setup_wizard_welcome_reset" />

    </org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory>

    <org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory
        app:layout="@layout/preference_category_custom"
        app:title="@string/text_debug">

        <org.autojs.autojs.theme.preference.MaterialPreference
            app:layout="@layout/preference_custom"
            app:key="process_exit_history"
            app:title="@string/text_process_exit_history"
            app:summary="@string/summary_process_exit_history" />

        <org.autojs.autojs.theme.preference.ThemeColorSwitchPreference
            app:key="@string/key_leakcanary_enabled"
            app:layout="@layout/preference_custom"
            app:defaultValue="true"
            app:isPreferenceVisible="false"
            app:summary="@string/summary_leakcanary"
            app:title="@string/text_leakcanary" />

    </org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory>

</PreferenceScreen>
