<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory
        app:layout="@layout/preference_category_custom"
        app:title="@string/text_general">

        <org.autojs.autojs.ui.settings.EditorEnginePreference
            app:layout="@layout/preference_custom"
            app:key="@string/key_editor_engine"
            app:title="@string/text_editor_engine"
            app:itemKeys="@array/keys_editor_engine"
            app:itemValues="@array/values_editor_engine"
            app:itemDefaultKey="@string/default_key_editor_engine"
            app:longClickPrompt="@string/description_editor_engine_preference" />

    </org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory>

    <org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory
        app:layout="@layout/preference_category_custom"
        app:title="@string/text_appearance">

        <org.autojs.autojs.theme.preference.MaterialListPreference
            app:layout="@layout/preference_custom"
            app:key="@string/key_editor_theme_mode"
            app:title="@string/text_editor_theme_mode"
            app:itemKeys="@array/keys_editor_theme_mode"
            app:itemValues="@array/values_editor_theme_mode"
            app:itemDefaultKey="@string/default_key_editor_theme_mode"
            app:longClickPrompt="@string/description_editor_theme_mode_preference" />

        <org.autojs.autojs.ui.settings.EditorThemePreference
            app:layout="@layout/preference_custom"
            app:key="@string/key_editor_theme"
            app:title="@string/text_editor_theme" />

        <org.autojs.autojs.ui.settings.AceEditorFontPreference
            app:layout="@layout/preference_custom"
            app:key="@string/key_ace_editor_font"
            app:title="@string/text_ace_editor_font"
            app:longClickPrompt="@string/description_ace_editor_font_preference" />

        <org.autojs.autojs.ui.settings.EditorTextSizePreference
            app:layout="@layout/preference_custom"
            app:key="@string/key_editor_text_size"
            app:title="@string/text_text_size" />

        <org.autojs.autojs.theme.preference.ThemeColorSwitchPreference
            app:layout="@layout/preference_custom"
            app:key="@string/key_ace_font_ligatures_enabled"
            app:defaultValue="@bool/pref_ace_font_ligatures_enabled"
            app:title="@string/text_ace_font_ligatures_enabled"
            app:summary="@string/summary_ace_font_ligatures_enabled"
            app:longClickPrompt="@string/description_ace_font_ligatures_enabled_preference" />

        <org.autojs.autojs.theme.preference.ThemeColorSwitchPreference
            app:layout="@layout/preference_custom"
            app:key="@string/key_ace_font_styles_enabled"
            app:defaultValue="@bool/pref_ace_font_styles_enabled"
            app:title="@string/text_ace_font_styles_enabled"
            app:summary="@string/summary_ace_font_styles_enabled"
            app:longClickPrompt="@string/description_ace_font_styles_enabled_preference" />

        <org.autojs.autojs.theme.preference.ThemeColorSwitchPreference
            app:layout="@layout/preference_custom"
            app:key="@string/key_ace_print_margin_enabled"
            app:defaultValue="@bool/pref_ace_print_margin_enabled"
            app:title="@string/text_ace_print_margin_enabled"
            app:summary="@string/summary_ace_print_margin_enabled"
            app:longClickPrompt="@string/description_ace_print_margin_enabled_preference" />

        <org.autojs.autojs.theme.preference.ThemeColorSwitchPreference
            app:layout="@layout/preference_custom"
            app:key="@string/key_ace_indent_guides_enabled"
            app:defaultValue="@bool/pref_ace_indent_guides_enabled"
            app:title="@string/text_ace_indent_guides_enabled"
            app:summary="@string/summary_ace_indent_guides_enabled"
            app:longClickPrompt="@string/description_ace_indent_guides_enabled_preference" />

        <org.autojs.autojs.theme.preference.ThemeColorSwitchPreference
            app:layout="@layout/preference_custom"
            app:key="@string/key_ace_word_wrap_enabled"
            app:defaultValue="@bool/pref_ace_word_wrap_enabled"
            app:title="@string/text_ace_word_wrap_enabled"
            app:summary="@string/summary_ace_word_wrap_enabled"
            app:longClickPrompt="@string/description_ace_word_wrap_enabled_preference" />

        <org.autojs.autojs.theme.preference.MaterialListPreference
            app:layout="@layout/preference_custom"
            app:key="@string/key_editor_word_wrap_indent_style"
            app:title="@string/text_editor_word_wrap_indent_style"
            app:itemKeys="@array/keys_editor_word_wrap_indent_style"
            app:itemValues="@array/values_editor_word_wrap_indent_style"
            app:itemDefaultKey="@string/default_key_editor_word_wrap_indent_style"
            app:longClickPrompt="@string/description_editor_word_wrap_indent_style_preference" />

    </org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory>

    <org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory
        app:layout="@layout/preference_category_custom"
        app:title="@string/text_log">

        <org.autojs.autojs.theme.preference.MaterialListPreference
            app:layout="@layout/preference_custom"
            app:key="@string/key_editor_log_button_behavior"
            app:title="@string/text_editor_log_button_behavior"
            app:itemKeys="@array/keys_editor_log_button_behavior"
            app:itemValues="@array/values_editor_log_button_behavior"
            app:itemDefaultKey="@string/default_key_editor_log_button_behavior"
            app:longClickPrompt="@string/description_editor_log_button_behavior_preference" />

        <org.autojs.autojs.theme.preference.ThemeColorSwitchPreference
            app:layout="@layout/preference_custom"
            app:key="@string/key_editor_auto_show_log_bottom_sheet_on_run"
            app:defaultValue="@bool/pref_editor_auto_show_log_bottom_sheet_on_run"
            app:title="@string/text_editor_auto_show_log_bottom_sheet_on_run"
            app:summary="@string/summary_editor_auto_show_log_bottom_sheet_on_run" />

    </org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory>

    <org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory
        app:layout="@layout/preference_category_custom"
        app:title="@string/text_editor_assistance">

        <org.autojs.autojs.ui.settings.EditorShortcutInputPreference
            app:layout="@layout/preference_custom"
            app:key="@string/key_editor_shortcut_input_bar"
            app:title="@string/text_editor_shortcut_input_bar"
            app:summary="@string/summary_editor_shortcut_input_bar" />

        <org.autojs.autojs.theme.preference.ThemeColorSwitchPreference
            app:layout="@layout/preference_custom"
            app:key="@string/key_ace_lsp_enabled"
            app:defaultValue="@bool/pref_ace_lsp_enabled"
            app:title="@string/text_ace_lsp_enabled"
            app:summary="@string/summary_ace_lsp_enabled"
            app:longClickPrompt="@string/description_ace_lsp_enabled_preference" />

        <org.autojs.autojs.ui.settings.AceLspFileTypesPreference
            app:layout="@layout/preference_custom"
            app:key="@string/key_ace_lsp_file_types"
            app:title="@string/text_ace_lsp_file_types"
            app:summary="@string/summary_ace_lsp_file_types"
            app:longClickPrompt="@string/description_ace_lsp_file_types_preference" />

    </org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory>

    <org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory
        app:layout="@layout/preference_category_custom"
        app:title="@string/text_editor_gestures">

        <org.autojs.autojs.theme.preference.ThemeColorSwitchPreference
            app:layout="@layout/preference_custom"
            app:key="@string/key_editor_pinch_to_zoom_change_text_size_enabled"
            app:defaultValue="@bool/pref_editor_pinch_to_zoom_change_text_size_enabled"
            app:title="@string/text_editor_pinch_to_zoom_change_text_size_enabled"
            app:summary="@string/summary_editor_pinch_to_zoom_change_text_size_enabled" />

    </org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory>

    <org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory
        app:layout="@layout/preference_category_custom"
        app:title="@string/text_editor_gutter_markers">

        <org.autojs.autojs.theme.preference.MaterialListPreference
            app:layout="@layout/preference_custom"
            app:key="@string/key_editor_gutter_width_mode"
            app:title="@string/text_editor_gutter_width_mode"
            app:itemKeys="@array/keys_editor_gutter_width_mode"
            app:itemValues="@array/values_editor_gutter_width_mode"
            app:itemDefaultKey="@string/default_key_editor_gutter_width_mode"
            app:longClickPrompt="@string/description_editor_gutter_width_mode_preference" />

        <org.autojs.autojs.theme.preference.ThemeColorSwitchPreference
            app:layout="@layout/preference_custom"
            app:key="@string/key_editor_breakpoint_markers_enabled"
            app:defaultValue="true"
            app:title="@string/text_editor_breakpoint_markers_enabled"
            app:summary="@string/summary_editor_breakpoint_markers_enabled"
            app:longClickPrompt="@string/description_editor_breakpoint_markers_enabled_preference" />

        <org.autojs.autojs.theme.preference.ThemeColorSwitchPreference
            app:layout="@layout/preference_custom"
            app:key="@string/key_ace_line_numbers_enabled"
            app:defaultValue="@bool/pref_ace_line_numbers_enabled"
            app:title="@string/text_ace_line_numbers_enabled"
            app:summary="@string/summary_ace_line_numbers_enabled"
            app:longClickPrompt="@string/description_ace_line_numbers_enabled_preference" />

        <org.autojs.autojs.theme.preference.ThemeColorSwitchPreference
            app:layout="@layout/preference_custom"
            app:key="@string/key_editor_fold_markers_enabled"
            app:defaultValue="true"
            app:title="@string/text_editor_fold_markers_enabled"
            app:summary="@string/summary_editor_fold_markers_enabled"
            app:longClickPrompt="@string/description_editor_fold_markers_enabled_preference" />

    </org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory>

    <org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory
        app:layout="@layout/preference_category_custom"
        app:title="@string/text_editor_performance">

        <org.autojs.autojs.ui.settings.EditorCodeHighlightThresholdPreference
            app:layout="@layout/preference_custom"
            app:key="@string/key_editor_code_highlight_threshold_bytes"
            app:title="@string/text_editor_code_highlight_threshold"
            app:longClickPrompt="@string/description_editor_code_highlight_threshold" />

        <org.autojs.autojs.ui.settings.EditorLargeFileModeThresholdPreference
            app:layout="@layout/preference_custom"
            app:key="@string/key_editor_large_file_mode_threshold_bytes"
            app:title="@string/text_editor_large_file_mode_threshold"
            app:longClickPrompt="@string/description_editor_large_file_mode_threshold" />

    </org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory>

</PreferenceScreen>
