"use strict";

type ProbeInput = {
  label: string;
  count: number;
};

type ProbeResult = {
  ok: boolean;
  summary: string;
};

function double(value: number): number {
  return value * 2;
}

module.exports = function runTypeScriptSourceProbe(input: ProbeInput): ProbeResult {
  const normalized: string = input.label.trim().toLowerCase();
  const doubled: number = double(input.count);
  return {
    ok: normalized === "autojs" && doubled === 12,
    summary: "ts:source/" + normalized + "/" + input.count + "/" + doubled,
  };
};
