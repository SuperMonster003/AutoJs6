<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name="org.autojs.autojs.model.explorer.ExternalFileReceiverProbeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:process=":external_file_receiver_probe"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <activity android:name="org.autojs.autojs.core.plugin.center.LauncherIconFixtureActivity"
            android:exported="true" />
        <activity-alias android:name="${applicationId}.launcher.Auto"
            android:targetActivity="org.autojs.autojs.core.plugin.center.LauncherIconFixtureActivity"
            android:enabled="true" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name="${applicationId}.launcher.Light"
            android:targetActivity="org.autojs.autojs.core.plugin.center.LauncherIconFixtureActivity"
            android:enabled="false" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name="${applicationId}.launcher.Dark"
            android:targetActivity="org.autojs.autojs.core.plugin.center.LauncherIconFixtureActivity"
            android:enabled="false" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <provider
            android:name="org.autojs.autojs.runtime.api.augment.installer.InstallerSmokePipeProvider"
            android:authorities="${applicationId}.installer.smoke.pipe"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN" />
        <provider
            android:name="org.autojs.autojs.core.plugin.installer.InstallerSourceTestProvider"
            android:authorities="${applicationId}.installer.sources"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN" />
        <service
            android:name="org.autojs.autojs.core.plugin.agent.AgentCallbackDeathService"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:process=":agent_callback_death" />
        <activity
            android:name="org.autojs.autojs.ui.pager.ScrollControllableViewPagerTestActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    </application>

</manifest>
