<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name="org.autojs.autojs.ui.explorer.ExplorerPathMenuProbeActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="org.autojs.autojs.core.plugin.compose.ComposeInsetsProbeActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <provider
            android:name="org.autojs.autojs.app.ApplicationContextProbeProvider"
            android:authorities="${applicationId}.context-probe"
            android:exported="false" />
        <provider
            android:name="org.autojs.autojs.core.plugin.installer.InstallerProcessProbeProvider"
            android:authorities="${applicationId}.installer-process-probe"
            android:exported="false"
            android:process=":installer_process_source" />
        <activity
            android:name="org.autojs.autojs.core.plugin.installer.InstallerProcessProbeActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:process=":installer_process_probe"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <service
            android:name="org.autojs.autojs.compat.ParcelCompatibilityProbeService"
            android:exported="false"
            android:process=":sdk37_parcel_probe" />
        <activity
            android:name="org.autojs.autojs.compat.ActivityLaunchCompatibilityProbeActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <activity
            android:name="org.autojs.autojs.compat.ActivityLaunchProbeLandingActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <activity
            android:name="org.autojs.autojs.compat.AudioCompatibilityProbeActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <receiver
            android:name="org.autojs.autojs.compat.AudioCompatibilityProbeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <activity
            android:name="org.autojs.autojs.engine.NodeAccessibilitySmokeActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <activity
            android:name="org.autojs.autojs.engine.AgentActionSmokeActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <activity
            android:name="org.autojs.autojs.ui.floating.codegen.CodeGenSmokeActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    </application>

    <queries>
        <package android:name="org.autojs.sdk37.balfixture" />
        <intent>
            <action android:name="org.autojs.plugin.python.RUNTIME" />
        </intent>
    </queries>

</manifest>
