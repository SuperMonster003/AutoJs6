{
  "schema": "autojs6-runtime-policy-v1",
  "status": "draft: exclusions follow docs/api-coverage/ROADMAP.md appendix D (D12), decided together in P1.4 (Q1); aliases only map host names to existing runtime entry names",
  "node": {
    "nativeModules": {
      "dns": "node:dns", "dns/promises": "node:dns/promises", "http": "node:http", "https": "node:https", "net": "node:net",
      "timers": "node:timers", "timers/promises": "node:timers/promises", "tls": "node:tls", "util": "node:util"
    },
    "moduleAliases": {
      "Arrayx": ["jsox.arrayx"],
      "Mathx": ["jsox.mathx"],
      "Numberx": ["jsox.numberx"],
      "auto": ["accessibility"],
      "automator": ["accessibility", "keys"],
      "cvt": ["converter"],
      "fmt": ["formatter"],
      "notice": ["notifications"],
      "storages": ["storage"],
      "timers": ["tasks"],
      "workManager": ["work_manager"]
    },
    "globalModules": ["autojs6:screen_metrics", "autojs6:compat"],
    "compatModule": "autojs6:compat",
    "memberAliases": {}
  },
  "bun": {
    "namespaceAliases": {
      "auto": ["accessibility"],
      "automator": ["accessibility"],
      "timers": ["tasks"]
    },
    "globalNamespaces": ["coordinates"],
    "namespaceCapabilities": {
      "compose": ["ui.compose"], "coordinates": ["screen.metrics"], "images": ["image.process", "image.files", "screen.capture"],
      "opencc": ["text.opencc"], "pinyin": ["text.pinyin"], "pinyin4j": ["text.pinyin4j"], "screenRecorder": ["screen.record"],
      "shizuku": ["shell.shizuku"], "sqlite": ["database.control"], "storages": ["storage.control"], "ui": ["ui.layout"]
    },
    "memberAliases": {}
  },
  "returnedObjects": {},
  "exclusions": [
    {
      "id": "internal-exports",
      "match": ["__autojs6Tsx", "__autojs6TsxFragment", "ui.__autojs6Tsx", "ui.__autojs6TsxFragment", "events.__asEmitter__", "http.__okhttp__", "ui.__inflate__", "ui.__widgets__", "toString"],
      "columns": ["node_main", "node_worker", "bun"],
      "status": "not-portable", "reason": "rhino-only",
      "note": "policy.json internalExports / standardExports: compiler or Rhino internals, not script APIs (Q13)",
      "source": "policy.json"
    },
    {
      "id": "accessibility-sync-wait",
      "match": ["auto.waitFor"],
      "columns": ["node_main", "node_worker", "bun"],
      "status": "denied", "reason": "sync-only",
      "equivalent": "await accessibility.ensureEnabled(); flow waitFor* with node snapshots",
      "note": "accessibility powerDialog / waitFor / rawNode; powerDialog is reachable through keys.powerDialog, rawNode has no explicit host export",
      "source": "appendix D source 1 (Node HOST-API section 8)"
    },
    {
      "id": "sync-threads",
      "match": ["threads.*", "sync"],
      "columns": ["node_main", "node_worker", "bun"],
      "status": "not-portable", "reason": "sync-only",
      "equivalent": "Node worker_threads / Bun Worker with message passing",
      "source": "appendix D source 2"
    },
    {
      "id": "sync-continuation",
      "match": ["continuation.*"],
      "columns": ["node_main", "node_worker", "bun"],
      "status": "not-portable", "reason": "sync-only",
      "equivalent": "await on the Promise returned by the asynchronous entry",
      "source": "appendix D source 2"
    },
    {
      "id": "sync-sleep",
      "match": ["sleep"],
      "columns": ["node_main", "node_worker", "bun"],
      "status": "not-portable", "reason": "runtime-native",
      "equivalent": "await new Promise(resolve => setTimeout(resolve, ms)) (Node timers/promises setTimeout, Bun.sleep)",
      "source": "appendix D source 2"
    },
    {
      "id": "sync-keep-alive",
      "match": ["keepAlive", "loop", "timers.keepAlive"],
      "columns": ["node_main", "node_worker", "bun"],
      "status": "not-portable", "reason": "runtime-native",
      "equivalent": "the runtime event loop stays alive while timers, listeners or pending Promises exist",
      "source": "appendix D source 2 (timers synchronous semantics)"
    },
    {
      "id": "java-prototype",
      "match": ["unwrapJavaObject", "util.unwrapJavaObject", "isJavaObject", "isJavaClass", "isJavaPackage"],
      "columns": ["node_main", "node_worker", "bun"],
      "status": "not-portable", "reason": "java-prototype",
      "equivalent": "java module handles (java.create / java.callInstance / java.callStatic)",
      "note": "isJava* entries are inferred from the appendix wording, review in P1.4",
      "source": "appendix D source 2"
    },
    {
      "id": "jsox-extensions",
      "match": ["Arrayx.*", "Mathx.*", "Numberx.*", "jsox.*"],
      "columns": ["node_main", "node_worker", "bun"],
      "status": "not-portable", "reason": "rhino-only",
      "note": "Node exposes explicit jsox functions (shadows this rule on the main thread); Bun to be decided (Q1)",
      "source": "appendix D source 2"
    },
    {
      "id": "rhino-engine",
      "match": ["engines.execScript", "engines.execScriptFile", "engines.execAutoFile", "plugins.load"],
      "columns": ["node_main", "node_worker", "bun"],
      "status": "not-portable", "reason": "rhino-only",
      "note": "operate the Rhino engine itself; read-only queries (version, running scripts) are not excluded",
      "source": "appendix D source 3"
    },
    {
      "id": "native-http",
      "match": ["http.*"],
      "columns": ["node_main", "node_worker", "bun"],
      "status": "not-portable", "reason": "runtime-native",
      "equivalent": "global fetch (Node / Bun), node:http; autojs6:fetch for host proxy / certificate policy",
      "note": "per-function review in P1.4: host-specific behavior (cookies, proxy settings) still needs bridged or local-shim",
      "source": "appendix D source 3"
    },
    {
      "id": "native-timers",
      "match": ["setTimeout", "setInterval", "setImmediate", "clearTimeout", "clearInterval", "clearImmediate"],
      "columns": ["bun"],
      "status": "not-portable", "reason": "runtime-native",
      "equivalent": "global setTimeout / setInterval / setImmediate and their clear functions",
      "source": "appendix D source 3"
    },
    {
      "id": "native-crypto",
      "match": ["crypto.*"],
      "columns": ["node_main", "node_worker", "bun"],
      "status": "not-portable", "reason": "runtime-native",
      "equivalent": "node:crypto KeyObject / generateKeyPair, WebCrypto (globalThis.crypto.subtle)",
      "source": "appendix D source 3"
    },
    {
      "id": "native-base64",
      "match": ["base64.*"],
      "columns": ["node_worker", "bun"],
      "status": "not-portable", "reason": "runtime-native",
      "equivalent": "Buffer.from(text).toString(\"base64\") / Buffer.from(data, \"base64\"), atob / btoa",
      "source": "appendix D source 3"
    }
  ]
}
