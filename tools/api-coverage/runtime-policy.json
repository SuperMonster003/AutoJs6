  "returnedObjects": {
    "_note": "Q27 (a), maintainer 2026-10-25: augment-prototype objects with a runtime handle type, compared member by member (node: declaring module and type in docs/nodejs/types/autojs6-node; bun: the host client namespace producing the handle, its type in host-client.d.mts and the grant of the producing call); type arguments only feed the Ace queries",
    "AgentRun": {"node": {"module": "autojs6:ai", "type": "AgentRun"}, "bun": {"namespace": "ai", "type": "RuntimeAi.AgentRun", "capability": "agent.control"}},
    "AiSession": {"node": {"module": "autojs6:ai", "type": "Session"}, "bun": {"namespace": "ai", "type": "RuntimeAi.Session", "capability": "ai.control"}},
    "EpubBook": {"node": {"module": "autojs6:epub", "type": "Book"}, "bun": {"namespace": "epub", "type": "RuntimeEpub.Book", "capability": "epub.control"}},
    "Flow": {"node": {"module": "autojs6:flow", "type": "Flow<unknown>"}, "bun": {"namespace": "flow", "type": "RuntimeFlow.Flow<unknown>", "capability": "flow.control"}},
    "MailClient": {"node": {"module": "autojs6:mail", "type": "Client"}, "bun": {"namespace": "mail", "type": "RuntimeMail.Client", "capability": "mail.control"}},
    "ShellProcess": {"node": {"module": "autojs6:shell", "type": "ShellProcess"}, "bun": {"namespace": "shell", "type": "RuntimeShell.ShellProcess", "capability": "shell.control"}},
    "Storage": {"node": {"module": "storages", "type": "StorageStore"}, "bun": {"namespace": "storages", "type": "RuntimeStorage.StorageStore", "capability": "storage.control"}}
  },
  "exclusions": [
    {
      "id": "internal-exports",
      "match": ["__autojs6Tsx", "__autojs6TsxFragment", "ui.__autojs6Tsx", "ui.__autojs6TsxFragment", "events.__asEmitter__", "http.__okhttp__", "ui.__inflate__", "ui.__widgets__", "toString"],
      "columns": ["node_main", "node_worker", "bun"],
      "status": "not-portable", "reason": "rhino-only",
      "note": "policy.json internalExports / standardExports: compiler or Rhino internals, not script APIs (Q13)",
      "source": "policy.json; appendix D D-15 (Q13 (a))"
    },
    {
      "id": "java-prototype",
      "match": ["unwrapJavaObject", "util.unwrapJavaObject", "isJavaObject", "isJavaClass", "isJavaPackage"],
      "columns": ["node_main", "node_worker", "bun"],
      "status": "not-portable", "reason": "java-prototype",
      "equivalent": "java module handles (java.create / java.callInstance / java.callStatic)",
      "override": true,
      "source": "appendix D D-11, maintainer 2026-10-29 (P1.4 question 5); override since P3.2a: the global isJavaClass / isJavaPackage placements stay excluded as decided although the owner module species covers them on Node"
    },
    {
      "id": "java-prototype-objects",
      "match": ["*#*"],
      "memberSource": "kotlin-class",
      "columns": ["node_main", "node_worker", "bun"],
      "status": "not-portable", "reason": "java-prototype",
      "note": "members of returned objects read from Kotlin classes (UiObject, ImageWrapper, Dialog, Database, ...): Node / Bun have no such Java object; augment-prototype handles (Flow, MailClient, ShellProcess, ...) stay pending for P3 / P4",
      "source": "Q17 (a), maintainer 2026-10-25; appendix D D-11 (P1.4)"
    },
    {
      "id": "rhino-engine",
      "match": ["plugins.load"],
      "columns": ["node_worker", "bun"],
      "status": "not-portable", "reason": "rhino-only",
      "note": "loads Rhino plugin modules; the Node main thread plugins.load is a local scan of ./plugins. engines.execScript / execScriptFile / execAutoFile are not excluded (Node main bridges them)",
      "source": "appendix D D-14, maintainer 2026-10-29 (P1.4 question 8)"
    },
    {
      "id": "http-java-objects",
      "match": ["http.client", "http.buildRequest"],
      "columns": ["node_main", "node_worker", "bun"],
      "status": "not-portable", "reason": "java-prototype",
      "equivalent": "fetch / Node autojs6:fetch request options (method, headers, body) instead of the OkHttp client and request objects",
      "note": "return okhttp3.OkHttpClient / okhttp3.Request",
      "source": "appendix D D-9, maintainer 2026-10-29 (P1.4 question 2)"
    },
    {
      "id": "native-http",
      "match": ["http.*"],
      "columns": ["node_main", "node_worker", "bun"],
      "status": "not-portable", "reason": "runtime-native",
      "equivalent": "global fetch (Node / Bun), node:http; autojs6:fetch for host proxy / certificate policy",
      "note": "host proxy / certificate policy through Node autojs6:fetch (GET / POST); http.client / buildRequest are http-java-objects",
      "source": "appendix D D-9, maintainer 2026-10-29 (P1.4 question 2)"
    },
    {
      "id": "native-timers",
      "match": ["setTimeout", "setInterval", "setImmediate", "clearTimeout", "clearInterval", "clearImmediate"],
      "columns": ["bun"],
      "status": "not-portable", "reason": "runtime-native",
      "equivalent": "global setTimeout / setInterval / setImmediate and their clear functions",
      "source": "appendix D D-9, maintainer 2026-10-29 (P1.4 question 2)"
    },
    {
      "id": "native-crypto",
      "match": ["crypto.*"],
      "columns": ["node_main", "node_worker", "bun"],
      "status": "not-portable", "reason": "runtime-native",
      "equivalent": "node:crypto KeyObject / generateKeyPair, WebCrypto (globalThis.crypto.subtle)",
      "source": "appendix D D-9, maintainer 2026-10-29 (P1.4 question 2)"
    },
    {
      "id": "native-base64",
      "match": ["base64.*"],
      "columns": ["node_worker", "bun"],
      "status": "not-portable", "reason": "runtime-native",
      "equivalent": "Buffer.from(text).toString(\"base64\") / Buffer.from(data, \"base64\"), atob / btoa",
      "source": "appendix D D-9, maintainer 2026-10-29 (P1.4 question 2)"
    }
  ]
}
