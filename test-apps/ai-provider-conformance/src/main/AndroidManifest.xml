<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="org.autojs.autojs6" />
    </queries>

    <application
        android:allowBackup="false"
        android:extractNativeLibs="false"
        android:label="AutoJs6 3-Stone AI Conformance"
        android:supportsRtl="true"
        android:testOnly="true"
        android:usesCleartextTraffic="false">

        <service
            android:name=".service.FakeAiProviderService"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:process=":provider">

            <intent-filter>
                <action android:name="org.autojs.plugin.AI_PROVIDER" />
            </intent-filter>
        </service>

        <service
            android:name=".service.IsolatedWrongUidAiCallbackService"
            android:enabled="true"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":wrong_uid_relay" />

    </application>
</manifest>
