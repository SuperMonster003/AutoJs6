<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="org.autojs.permission.PLUGIN" />
    <queries>
        <package android:name="org.autojs.autojs6" />
    </queries>
    <application
        android:allowBackup="false"
        android:label="AutoJs6 3-Stove Agent Conformance"
        android:supportsRtl="true"
        android:testOnly="true"
        android:usesCleartextTraffic="false">
        <service
            android:name=".BrokerConformanceService"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:process=":agent">
            <!-- Visible to the host's existing query; the production host pins the real package. -->
            <intent-filter>
                <action android:name="org.autojs.plugin.THREE_STOVE_AGENT" />
                <category android:name="three-stove-agent" />
            </intent-filter>
        </service>
    </application>
</manifest>
