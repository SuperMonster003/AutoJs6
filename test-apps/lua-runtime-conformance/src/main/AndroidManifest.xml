<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="org.autojs.autojs6" />
    </queries>

    <application
        android:allowBackup="false"
        android:extractNativeLibs="false"
        android:label="Lua Runtime Conformance"
        android:supportsRtl="true"
        android:testOnly="true"
        android:usesCleartextTraffic="false">

        <service
            android:name=".service.FakeLuaPluginInfoService"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:process=":lua_runtime">

            <intent-filter>
                <action android:name="org.autojs.plugin.INFO" />
            </intent-filter>
        </service>

        <service
            android:name=".service.StallLuaPluginInfoService"
            android:enabled="false"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:process=":lua_runtime">

            <intent-filter>
                <action android:name="org.autojs.plugin.INFO" />
            </intent-filter>
        </service>

        <service
            android:name=".service.FakeLuaConformanceControlService"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:process=":lua_runtime">

            <intent-filter>
                <action android:name="org.autojs.plugin.lua.runtime.fake.CONTROL" />
            </intent-filter>
        </service>

        <service
            android:name=".service.NormalLuaRuntimeService"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:process=":lua_runtime">

            <intent-filter>
                <action android:name="org.autojs.plugin.lua.RUNTIME" />
            </intent-filter>

            <meta-data
                android:name="org.autojs.plugin.lua.runtime.fake.SCENARIO"
                android:value="normal" />
        </service>

        <service
            android:name=".service.MalformedRuntimeInfoLuaRuntimeService"
