<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="org.autojs.autojs6" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="AutoJs6 DEX Compiler Conformance"
        android:supportsRtl="true"
        android:testOnly="true"
        android:usesCleartextTraffic="false">

        <service
            android:name=".service.NormalDexCompilerService"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:process=":compiler">

            <intent-filter>
                <action android:name="org.autojs.plugin.DEX_COMPILER" />
            </intent-filter>

            <meta-data
                android:name="org.autojs.plugin.dexcompiler.fake.SCENARIO"
                android:value="normal" />
        </service>

        <service
            android:name=".service.ProgressBeforeStartDexCompilerService"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:process=":compiler">

            <intent-filter>
                <action android:name="org.autojs.plugin.DEX_COMPILER" />
            </intent-filter>

            <meta-data
                android:name="org.autojs.plugin.dexcompiler.fake.SCENARIO"
                android:value="progress-before-start" />
        </service>

        <service
            android:name=".service.DuplicateTerminalDexCompilerService"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:process=":compiler">

            <intent-filter>
                <action android:name="org.autojs.plugin.DEX_COMPILER" />
            </intent-filter>

            <meta-data
                android:name="org.autojs.plugin.dexcompiler.fake.SCENARIO"
                android:value="duplicate-terminal" />
        </service>

        <service
            android:name=".service.InvalidOutputDexCompilerService"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:process=":compiler">

            <intent-filter>
                <action android:name="org.autojs.plugin.DEX_COMPILER" />
            </intent-filter>

            <meta-data
                android:name="org.autojs.plugin.dexcompiler.fake.SCENARIO"
                android:value="invalid-output" />
        </service>

        <service
            android:name=".service.StallDexCompilerService"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:process=":compiler">

            <intent-filter>
                <action android:name="org.autojs.plugin.DEX_COMPILER" />
            </intent-filter>

            <meta-data
                android:name="org.autojs.plugin.dexcompiler.fake.SCENARIO"
                android:value="stall" />
        </service>

        <service
            android:name=".service.UnnegotiatedDexVersionCompilerService"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:process=":compiler">

            <intent-filter>
                <action android:name="org.autojs.plugin.DEX_COMPILER" />
            </intent-filter>

            <meta-data
                android:name="org.autojs.plugin.dexcompiler.fake.SCENARIO"
                android:value="unnegotiated-dex-version" />
        </service>

    </application>
</manifest>
