{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autojs6.local/schemas/nodejs/rhino-augment-inventory-v1.schema.json",
  "title": "AutoJs6 Rhino Augment Inventory",
  "description": "Inventory of Rhino Augmentable modules and their Node.js compatibility migration status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "source",
    "statusVocabulary",
    "modules"
  ],
  "properties": {
    "schema": {
      "const": "autojs6-node-rhino-augment-inventory-v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "description": "ISO-8601 generation timestamp. Fixtures may use a fixed value."
    },
    "source": {
      "$ref": "#/$defs/sourceDescriptor"
    },
    "statusVocabulary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/migrationStatus"
      },
      "minItems": 6,
      "uniqueItems": true
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "totals": {
      "$ref": "#/$defs/totals"
    }
  },
  "$defs": {
    "sourceDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "augmentRoot",
        "scriptRuntime",
        "scannerVersion"
      ],
      "properties": {
        "augmentRoot": {
          "type": "string",
          "minLength": 1
        },
        "scriptRuntime": {
          "type": "string",
          "minLength": 1
        },
        "scannerVersion": {
          "type": "string",
          "minLength": 1
        },
        "gitRevision": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key",
        "className",
        "packageName",
        "source",
        "registration",
        "augmentable",
        "exports",
        "migration"
      ],
      "dependentRequired": {
        "keys": [
          "mountNames"
        ],
        "mountNames": [
          "keys"
        ]
      },
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "description": "Primary module name. This v1 field remains the stable compatibility view of keys[0].name."
        },
        "keys": {
          "type": "array",
          "description": "Ordered declarative module-name descriptors. Optional so existing v1 inventory documents remain valid.",
          "items": {
            "$ref": "#/$defs/moduleKey"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "mountNames": {
          "type": "array",
          "description": "Ordered, collision-free final names produced by expanding keys. It must equal exports.moduleKeys when present.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "displayName": {
          "type": "string"
        },
        "className": {
          "type": "string",
          "minLength": 1
        },
        "packageName": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/sourceLocation"
        },
        "registration": {
          "$ref": "#/$defs/registration"
        },
        "augmentable": {
          "$ref": "#/$defs/augmentable"
        },
        "exports": {
          "$ref": "#/$defs/exports"
        },
        "migration": {
          "$ref": "#/$defs/migration"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registered",
        "site",
        "order",
        "target",
        "withDollarPrefix",
        "additionalAttributes"
      ],
      "properties": {
        "registered": {
          "type": "boolean"
        },
        "site": {
          "$ref": "#/$defs/sourceLocation"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "target": {
          "enum": [
            "top_level_scope",
            "module_object",
            "proxy_object",
            "prototype",
            "global_builtin",
            "unknown"
          ]
        },
        "parentModuleId": {
          "$ref": "#/$defs/stableId"
        },
        "method": {
          "type": "string",
          "description": "Registration method such as augment, augmentWithRuntime, assignWithRuntime, proxying."
        },
        "withDollarPrefix": {
          "type": "boolean",
          "description": "Legacy v1 compatibility mirror of the primary key descriptor's withDollarPrefix policy."
        },
        "additionalAttributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rhinoFlag"
          },
          "uniqueItems": true
        },
        "proto": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "augmentable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseClass",
        "traits",
        "construction",
        "requiresScriptRuntime"
      ],
      "properties": {
        "baseClass": {
          "enum": [
            "Augmentable",
            "AugmentableProxy",
            "unknown"
          ]
        },
        "traits": {
          "type": "array",
          "items": {
            "enum": [
              "Invokable",
              "Constructable",
              "Versatile",
              "AsEmitter",
              "JsBuildInObjectExtensible",
              "SimpleGetterProxy"
            ]
          },
          "uniqueItems": true
        },
        "construction": {
          "enum": [
            "plain_object",
            "base_function_invokable",
            "base_function_constructable",
            "base_function_versatile",
            "proxy_object",
            "prototype_extension",
            "unknown"
          ]
        },
        "requiresScriptRuntime": {
          "type": "boolean"
        },
        "originatesKeyName": {
          "type": "boolean"
        },
        "simpleGetterProxyInterface": {
          "type": "boolean"
        }
      }
    },
    "exports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moduleKeys",
        "entries"
      ],
      "properties": {
        "moduleKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/apiEntry"
          }
        }
      }
    },
    "apiEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "exposedName",
        "kind",
        "assignment",
        "source",
        "attributes",
        "migration"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "exposedName": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/apiKind"
        },
        "assignment": {
          "$ref": "#/$defs/assignment"
        },
        "source": {
          "$ref": "#/$defs/sourceLocation"
        },
        "attributes": {
          "$ref": "#/$defs/attributes"
        },
        "aliases": {
          "type": "array",
          "description": "Ordered alternate exposed names. Module-level generated entries may contain every mount name except exposedName.",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "signature": {
          "type": "string"
        },
        "migration": {
          "$ref": "#/$defs/migration"
        },
        "risks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/risk"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rhinoFlags",
        "dollarAlias"
      ],
      "properties": {
        "rhinoFlags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rhinoFlag"
          },
          "uniqueItems": true
        },
        "dollarAlias": {
          "type": "boolean"
        },
        "readonly": {
          "type": "boolean"
        },
        "enumerable": {
          "type": "boolean"
        },
        "configurable": {
          "type": "boolean"
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/migrationStatus"
        },
        "nodeModule": {
          "type": "string"
        },
        "bridgeModule": {
          "type": "string"
        },
        "nodeName": {
          "type": "string"
        },
        "asyncMode": {
          "$ref": "#/$defs/asyncMode"
        },
        "replacement": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "moduleCount": {
          "type": "integer",
          "minimum": 0
        },
        "apiEntryCount": {
          "type": "integer",
          "minimum": 0
        },
        "byStatus": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "sourceLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "moduleKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "withDollarPrefix"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "withDollarPrefix": {
          "type": "boolean",
          "description": "Whether this name also produces a dollar-prefixed mount name after the plain name."
        }
      }
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[A-Za-z_$][A-Za-z0-9_$]*)*$"
    },
    "apiKind": {
      "enum": [
        "augment_object",
        "global_function",
        "global_property",
        "self_function",
        "self_property",
        "getter",
        "getter_setter",
        "java_class",
        "constructor",
        "invokable",
        "proxy_accessor",
        "event_emitter",
        "prototype_extension",
        "alias",
        "simple_getter_proxy",
        "constant"
      ]
    },
    "assignment": {
      "enum": [
        "augment_key",
        "dollar_augment_key",
        "selfAssignmentProperties",
        "globalAssignmentProperties",
        "selfAssignmentFunctions",
        "globalAssignmentFunctions",
        "selfAssignmentJavaClasses",
        "globalAssignmentJavaClasses",
        "selfAssignmentGetters",
        "selfAssignmentGettersAndSetters",
        "globalAssignmentGetters",
        "prototype",
        "proxy",
        "annotation",
        "manual",
        "inferred"
      ]
    },
    "rhinoFlag": {
      "enum": [
        "PERMANENT",
        "READONLY",
        "DONTENUM",
        "AS_GLOBAL",
        "AS_IGNORED",
        "UNKNOWN"
      ]
    },
    "migrationStatus": {
      "enum": [
        "supported",
        "supported_async",
        "renamed",
        "partial",
        "blocked_by_design",
        "unsupported"
      ]
    },
    "asyncMode": {
      "enum": [
        "sync",
        "promise",
        "callback",
        "event",
        "blocking_compat",
        "not_applicable",
        "unknown"
      ]
    },
    "risk": {
      "enum": [
        "none",
        "raw_java_object",
        "raw_android_object",
        "lifecycle_resource",
        "permission",
        "background_execution",
        "scoped_fs",
        "provider_availability",
        "event_loop_semantics",
        "thread_model",
        "packaged_parity",
        "security_boundary"
      ]
    }
  }
}
