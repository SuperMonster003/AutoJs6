{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autojs6.local/schemas/phase15_surface_manifest.schema.json",
  "title": "AutoJs6 Node Phase 15 Surface Manifest",
  "type": "object",
  "required": [
    "schema",
    "phase",
    "updatedAt",
    "branch",
    "profileVocabulary",
    "riskVocabulary",
    "evidenceClassVocabulary",
    "importedBacklog",
    "ownerSurfaces",
    "taskMappings"
  ],
  "properties": {
    "schema": {
      "const": "autojs6-node-phase15-surface-manifest-v1"
    },
    "phase": {
      "const": "Phase 15: Node v1.3 Provider Promotion"
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "branch": {
      "const": "feature/nodejs-runtime-v1.3"
    },
    "profileVocabulary": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "safe_default",
          "pro_compat_opt_in",
          "desktop_compat_opt_in",
          "debug_unsafe_lab",
          "permanently_unsupported"
        ]
      }
    },
    "riskVocabulary": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "low",
          "medium",
          "high",
          "critical"
        ]
      }
    },
    "evidenceClassVocabulary": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      }
    },
    "importedBacklog": {
      "type": "object",
      "required": [
        "source",
        "classification",
        "tasks"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "classification": {
          "const": "v1.3 future promotion backlog"
        },
        "tasks": {
          "type": "array",
          "minItems": 19,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^P14-\\d{2}$"
          }
        }
      },
      "additionalProperties": false
    },
    "ownerSurfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "summary",
          "profiles",
          "risk",
          "rollbackHook"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_.]+$"
          },
          "summary": {
            "type": "string",
            "minLength": 16
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "safe_default",
                "pro_compat_opt_in",
                "desktop_compat_opt_in",
                "debug_unsafe_lab",
                "permanently_unsupported"
              ]
            }
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "rollbackHook": {
            "type": "string",
            "minLength": 8
          }
        },
        "additionalProperties": false
      }
    },
    "taskMappings": {
      "type": "array",
      "minItems": 28,
      "items": {
        "type": "object",
        "required": [
          "task",
          "ownerSurface",
          "sourceBacklogTasks",
          "profiles",
          "risk",
          "evidenceClass",
          "rollbackHook",
          "gate",
          "status"
        ],
        "properties": {
          "task": {
            "type": "string",
            "pattern": "^P15-\\d{2}$"
          },
          "ownerSurface": {
            "type": "string",
            "pattern": "^[a-z0-9_.]+$"
          },
          "sourceBacklogTasks": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^P14-\\d{2}$"
            }
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "safe_default",
                "pro_compat_opt_in",
                "desktop_compat_opt_in",
                "debug_unsafe_lab",
                "permanently_unsupported"
              ]
            }
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "evidenceClass": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "rollbackHook": {
            "type": "string",
            "minLength": 8
          },
          "gate": {
            "type": "string",
            "pattern": "^:app:[A-Za-z0-9]+$"
          },
          "status": {
            "enum": [
              "ready",
              "planned"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
