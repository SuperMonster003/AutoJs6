{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autojs6.local/schemas/rhino_ui_json_layout_subset.schema.json",
  "schema": "autojs6-node-rhino-ui-json-layout-subset-v1",
  "title": "AutoJs6 Node Rhino UI JSON Layout Subset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "entrypoints",
    "limits",
    "layoutDescriptor",
    "patchDescriptor",
    "rhinoApiMigration"
  ],
  "properties": {
    "schema": {
      "const": "autojs6-node-rhino-ui-json-layout-subset-v1"
    },
    "entrypoints": {
      "type": "array",
      "items": {
        "enum": [
          "ui.showLayout",
          "UiHandle.update",
          "UiHandle.batchUpdate",
          "UiHandle.on",
          "UiHandle.close",
          "future autojs6:compat.ui.showLayout"
        ]
      },
      "contains": {
        "const": "ui.showLayout"
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxJsonChars",
        "maxDepth",
        "maxObjectKeys",
        "maxArrayLength",
        "maxBatchPatches",
        "maxDrainEvents",
        "maxEventQueueSize"
      ],
      "properties": {
        "maxJsonChars": {
          "const": 32768
        },
        "maxDepth": {
          "const": 16
        },
        "maxObjectKeys": {
          "const": 64
        },
        "maxArrayLength": {
          "const": 128
        },
        "maxBatchPatches": {
          "const": 64
        },
        "maxDrainEvents": {
          "const": 64
        },
        "maxEventQueueSize": {
          "const": 128
        }
      }
    },
    "layoutDescriptor": {
      "$ref": "#/$defs/LayoutDescriptor"
    },
    "patchDescriptor": {
      "$ref": "#/$defs/PatchDescriptor"
    },
    "rhinoApiMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ui.layout",
        "ui.layoutFile",
        "ui.findById",
        "ui.run",
        "ui.post"
      ],
      "properties": {
        "ui.layout": {
          "const": "partial_json_descriptor_only"
        },
        "ui.layoutFile": {
          "const": "planned_json_file_only"
        },
        "ui.findById": {
          "const": "blocked_by_design"
        },
        "ui.run": {
          "const": "blocked_by_design"
        },
        "ui.post": {
          "const": "blocked_by_design"
        }
      }
    }
  },
  "$defs": {
    "LayoutType": {
      "enum": [
        "Column",
        "Row",
        "Vertical",
        "Horizontal",
        "LinearLayout",
        "Text",
        "Button",
        "Input",
        "Image",
        "ScrollView",
        "List",
        "Switch",
        "Checkbox",
        "CheckBox",
        "Progress",
        "ProgressBar",
        "Tabs",
        "Tab",
        "column",
        "row",
        "vertical",
        "horizontal",
        "linearLayout",
        "text",
        "button",
        "input",
        "image",
        "scrollView",
        "list",
        "switch",
        "checkbox",
        "checkBox",
        "progress",
        "progressBar",
        "tabs",
        "tab"
      ]
    },
    "JsonScalar": {
      "type": [
        "string",
        "number",
        "integer",
        "boolean",
        "null"
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "ListItem": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "properties": {
            "text": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/JsonValue"
            }
          }
        }
      ]
    },
    "LayoutDescriptor": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "not": {
          "pattern": "^on[A-Za-z]"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "properties": {
        "type": {
          "$ref": "#/$defs/LayoutType"
        },
        "id": {
          "type": "string"
        },
        "text": {
          "$ref": "#/$defs/JsonValue"
        },
        "hint": {
          "$ref": "#/$defs/JsonValue"
        },
        "title": {
          "type": "string"
        },
        "contentDescription": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        },
        "textSize": {
          "type": "number",
          "minimum": 8,
          "maximum": 48
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        },
        "checked": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "progress": {
          "type": "number"
        },
        "max": {
          "type": "number",
          "minimum": 1
        },
        "indeterminate": {
          "type": "boolean"
        },
        "selectedIndex": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/ListItem"
          }
        },
        "children": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/LayoutDescriptor"
          }
        },
        "content": {
          "$ref": "#/$defs/LayoutDescriptor"
        },
        "tabs": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/LayoutDescriptor"
          }
        }
      },
      "not": {
        "properties": {
          "type": {
            "enum": [
              "WebView",
              "webView",
              "webview"
            ]
          }
        },
        "required": [
          "type"
        ]
      }
    },
    "PatchDescriptor": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "not": {
          "pattern": "^on[A-Za-z]"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/LayoutType"
        },
        "text": {
          "$ref": "#/$defs/JsonValue"
        },
        "hint": {
          "$ref": "#/$defs/JsonValue"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        },
        "checked": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "progress": {
          "type": "number"
        },
        "max": {
          "type": "number",
          "minimum": 1
        },
        "indeterminate": {
          "type": "boolean"
        },
        "selectedIndex": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/ListItem"
          }
        }
      }
    }
  },
  "examples": [
    {
      "schema": "autojs6-node-rhino-ui-json-layout-subset-v1",
      "entrypoints": [
        "ui.showLayout",
        "UiHandle.update",
        "UiHandle.batchUpdate",
        "UiHandle.on",
        "UiHandle.close",
        "future autojs6:compat.ui.showLayout"
      ],
      "limits": {
        "maxJsonChars": 32768,
        "maxDepth": 16,
        "maxObjectKeys": 64,
        "maxArrayLength": 128,
        "maxBatchPatches": 64,
        "maxDrainEvents": 64,
        "maxEventQueueSize": 128
      },
      "layoutDescriptor": {
        "type": "Column",
        "children": [
          {
            "id": "name",
            "type": "Input",
            "hint": "Name"
          },
          {
            "id": "ok",
            "type": "Button",
            "text": "OK"
          }
        ]
      },
      "patchDescriptor": {
        "id": "ok",
        "text": "Done",
        "enabled": false
      },
      "rhinoApiMigration": {
        "ui.layout": "partial_json_descriptor_only",
        "ui.layoutFile": "planned_json_file_only",
        "ui.findById": "blocked_by_design",
        "ui.run": "blocked_by_design",
        "ui.post": "blocked_by_design"
      }
    }
  ]
}
