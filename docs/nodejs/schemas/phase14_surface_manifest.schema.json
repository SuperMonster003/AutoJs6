{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autojs6.local/schemas/phase14_surface_manifest.schema.json",
  "title": "AutoJs6 Node Phase 14 Surface Manifest",
  "type": "object",
  "required": [
    "schema",
    "phase",
    "updatedAt",
    "profileVocabulary",
    "statusVocabulary",
    "surfaces"
  ],
  "properties": {
    "schema": {
      "const": "autojs6-node-phase14-surface-manifest-v1"
    },
    "phase": {
      "const": "Phase 14: Node v1.2 Provider Promotion"
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "profileVocabulary": {
      "type": "array",
      "items": {
        "enum": [
          "safe_default",
          "pro_compat_opt_in",
          "desktop_compat_opt_in",
          "debug_unsafe_lab",
          "permanently_unsupported"
        ]
      },
      "minItems": 5,
      "uniqueItems": true
    },
    "statusVocabulary": {
      "type": "array",
      "items": {
        "enum": [
          "planned",
          "design_locked",
          "debug_poc",
          "provider_poc",
          "opt_in_promoted",
          "default_promoted",
          "rejected"
        ]
      },
      "minItems": 7,
      "uniqueItems": true
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "profiles",
          "tasks",
          "summary",
          "risk",
          "runtimeSurface",
          "evidence",
          "rollback"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_.]+$"
          },
          "status": {
            "enum": [
              "planned",
              "design_locked",
              "debug_poc",
              "provider_poc",
              "opt_in_promoted",
              "default_promoted",
              "rejected"
            ]
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "safe_default",
                "pro_compat_opt_in",
                "desktop_compat_opt_in",
                "debug_unsafe_lab",
                "permanently_unsupported"
              ]
            }
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^P14-\\d{2}$"
            }
          },
          "summary": {
            "type": "string",
            "minLength": 16
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "runtimeSurface": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rollback": {
            "type": "string",
            "minLength": 16
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
