{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autojs6.local/schemas/nodejs/overlay_provider_v1.schema.json",
  "title": "AutoJs6 Node ui.overlay provider v1 contract",
  "type": "object",
  "required": [
    "schema",
    "module",
    "capabilities",
    "limits",
    "methods"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "autojs6-node-overlay-provider-v1"
    },
    "module": {
      "const": "ui.overlay"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "ui.overlay",
          "ui.overlay.permission",
          "ui.overlay.foreground",
          "ui.overlay.packaged",
          "floaty.raw",
          "floaty.touch"
        ]
      },
      "uniqueItems": true,
      "minItems": 6,
      "maxItems": 6
    },
    "limits": {
      "$ref": "#/$defs/OverlayLimits"
    },
    "methods": {
      "type": "object",
      "required": [
        "show",
        "update",
        "drainEvents",
        "close",
        "closeAll",
        "hasPermission",
        "openPermissionSettings"
      ],
      "additionalProperties": false,
      "properties": {
        "show": {
          "$ref": "#/$defs/ShowMethod"
        },
        "update": {
          "$ref": "#/$defs/UpdateMethod"
        },
        "drainEvents": {
          "$ref": "#/$defs/DrainEventsMethod"
        },
        "close": {
          "$ref": "#/$defs/CloseMethod"
        },
        "closeAll": {
          "$ref": "#/$defs/CloseAllMethod"
        },
        "hasPermission": {
          "$ref": "#/$defs/HasPermissionMethod"
        },
        "openPermissionSettings": {
          "$ref": "#/$defs/OpenPermissionSettingsMethod"
        }
      }
    }
  },
  "$defs": {
    "OverlayLimits": {
      "type": "object",
      "required": [
        "maxActiveOverlays",
        "maxDescriptorBytes",
        "maxDescriptorDepth",
        "maxEventQueueSize",
        "maxDrainBatchSize",
        "maxLifetimeMs"
      ],
      "additionalProperties": false,
      "properties": {
        "maxActiveOverlays": {
          "const": 4
        },
        "maxDescriptorBytes": {
          "const": 65536
        },
        "maxDescriptorDepth": {
          "const": 16
        },
        "maxEventQueueSize": {
          "const": 128
        },
        "maxDrainBatchSize": {
          "const": 64
        },
        "maxLifetimeMs": {
          "const": 3600000
        }
      }
    },
    "OverlayDescriptor": {
      "type": "object",
      "required": [
        "content",
        "disclosure"
      ],
      "additionalProperties": false,
      "properties": {
        "content": {
          "$ref": "#/$defs/JsonLayoutDescriptor"
        },
        "window": {
          "$ref": "#/$defs/OverlayWindowOptions"
        },
        "disclosure": {
          "$ref": "#/$defs/OverlayDisclosure"
        }
      }
    },
    "JsonLayoutDescriptor": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "not": {
            "enum": [
              "NativeView",
              "WebView",
              "WindowManager",
              "FloatyWindow"
            ]
          }
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "OverlayWindowOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "$ref": "#/$defs/Dimension"
        },
        "height": {
          "$ref": "#/$defs/Dimension"
        },
        "x": {
          "type": "integer",
          "minimum": -4096,
          "maximum": 4096
        },
        "y": {
          "type": "integer",
          "minimum": -4096,
          "maximum": 4096
        },
        "touchable": {
          "type": "boolean"
        },
        "focusable": {
          "type": "boolean"
        },
        "draggable": {
          "type": "boolean"
        },
        "visible": {
          "const": true
        },
        "alpha": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 1
        }
      }
    },
    "Dimension": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        {
          "enum": [
            "wrap_content",
            "match_parent"
          ]
        }
      ]
    },
    "OverlayDisclosure": {
      "type": "object",
      "required": [
        "title",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "OverlaySnapshot": {
      "type": "object",
      "required": [
        "id",
        "type",
        "closed",
        "visible",
        "createdAt"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "const": "overlay"
        },
        "closed": {
          "type": "boolean"
        },
        "visible": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0
        },
        "bounds": {
          "$ref": "#/$defs/OverlayBounds"
        },
        "disclosure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string"
            }
          }
        },
        "droppedCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "OverlayBounds": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "OverlayEvent": {
      "type": "object",
      "required": [
        "type",
        "overlayId",
        "eventTime"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "overlayId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "eventTime": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "maxLength": 160
        },
        "state": {
          "type": "object"
        }
      }
    },
    "OverlayOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "maxEvents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "OverlayPermissionSnapshot": {
      "type": "object",
      "required": [
        "granted",
        "canOpenSettings"
      ],
      "additionalProperties": false,
      "properties": {
        "granted": {
          "type": "boolean"
        },
        "canOpenSettings": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "maxLength": 160
        }
      }
    },
    "OverlayPermissionSettingsResult": {
      "type": "object",
      "required": [
        "opened"
      ],
      "additionalProperties": false,
      "properties": {
        "opened": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "maxLength": 160
        }
      }
    },
    "OverlayCloseSummary": {
      "type": "object",
      "required": [
        "closedCount",
        "remainingCount"
      ],
      "additionalProperties": false,
      "properties": {
        "closedCount": {
          "type": "integer",
          "minimum": 0
        },
        "remainingCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ShowMethod": {
      "type": "object",
      "required": [
        "args",
        "response",
        "capabilities"
      ],
      "additionalProperties": false,
      "properties": {
        "args": {
          "prefixItems": [
            {
              "$ref": "#/$defs/OverlayDescriptor"
            },
            {
              "$ref": "#/$defs/OverlayOptions"
            }
          ],
          "minItems": 1,
          "maxItems": 2
        },
        "response": {
          "$ref": "#/$defs/OverlaySnapshot"
        },
        "capabilities": {
          "const": [
            "ui.overlay"
          ]
        }
      }
    },
    "UpdateMethod": {
      "type": "object",
      "required": [
        "args",
        "response",
        "capabilities"
      ],
      "additionalProperties": false,
      "properties": {
        "args": {
          "const": [
            "overlayId",
            "patch",
            "options?"
          ]
        },
        "response": {
          "$ref": "#/$defs/OverlaySnapshot"
        },
        "capabilities": {
          "const": [
            "ui.overlay"
          ]
        }
      }
    },
    "DrainEventsMethod": {
      "type": "object",
      "required": [
        "args",
        "response",
        "capabilities"
      ],
      "additionalProperties": false,
      "properties": {
        "args": {
          "const": [
            "overlayId",
            "options?"
          ]
        },
        "response": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OverlayEvent"
          }
        },
        "capabilities": {
          "const": [
            "ui.overlay"
          ]
        }
      }
    },
    "CloseMethod": {
      "type": "object",
      "required": [
        "args",
        "response",
        "capabilities"
      ],
      "additionalProperties": false,
      "properties": {
        "args": {
          "const": [
            "overlayId",
            "options?"
          ]
        },
        "response": {
          "type": "boolean"
        },
        "capabilities": {
          "const": [
            "ui.overlay"
          ]
        }
      }
    },
    "CloseAllMethod": {
      "type": "object",
      "required": [
        "args",
        "response",
        "capabilities"
      ],
      "additionalProperties": false,
      "properties": {
        "args": {
          "const": [
            "options?"
          ]
        },
        "response": {
          "$ref": "#/$defs/OverlayCloseSummary"
        },
        "capabilities": {
          "const": [
            "ui.overlay"
          ]
        }
      }
    },
    "HasPermissionMethod": {
      "type": "object",
      "required": [
        "args",
        "response",
        "capabilities"
      ],
      "additionalProperties": false,
      "properties": {
        "args": {
          "const": [
            "options?"
          ]
        },
        "response": {
          "$ref": "#/$defs/OverlayPermissionSnapshot"
        },
        "capabilities": {
          "const": [
            "ui.overlay.permission"
          ]
        }
      }
    },
    "OpenPermissionSettingsMethod": {
      "type": "object",
      "required": [
        "args",
        "response",
        "capabilities"
      ],
      "additionalProperties": false,
      "properties": {
        "args": {
          "const": [
            "options?"
          ]
        },
        "response": {
          "$ref": "#/$defs/OverlayPermissionSettingsResult"
        },
        "capabilities": {
          "const": [
            "ui.overlay.permission"
          ]
        }
      }
    }
  }
}
