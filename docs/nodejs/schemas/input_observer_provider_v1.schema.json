{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autojs6.local/schemas/nodejs/input_observer_provider_v1.schema.json",
  "title": "AutoJs6 Node input_observer provider v1 contract",
  "type": "object",
  "required": [
    "schema",
    "module",
    "capabilities",
    "limits",
    "methods"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "autojs6-node-input-observer-provider-v1"
    },
    "module": {
      "const": "input_observer"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "input_observer",
          "input_observer.keys",
          "input_observer.touch",
          "input_observer.intercept"
        ]
      },
      "uniqueItems": true,
      "minItems": 4,
      "maxItems": 4
    },
    "limits": {
      "$ref": "#/$defs/InputObserverLimits"
    },
    "methods": {
      "type": "object",
      "required": [
        "observeKeys",
        "drainEvents",
        "close",
        "getAvailableSources"
      ],
      "additionalProperties": false,
      "properties": {
        "observeKeys": {
          "$ref": "#/$defs/ObserveKeysMethod"
        },
        "drainEvents": {
          "$ref": "#/$defs/DrainEventsMethod"
        },
        "close": {
          "$ref": "#/$defs/CloseMethod"
        },
        "getAvailableSources": {
          "$ref": "#/$defs/GetAvailableSourcesMethod"
        }
      }
    }
  },
  "$defs": {
    "InputObserverLimits": {
      "type": "object",
      "required": [
        "maxActiveSubscriptions",
        "maxQueueSize",
        "maxDrainBatchSize",
        "maxEventBytes",
        "maxTimeoutMs"
      ],
      "additionalProperties": false,
      "properties": {
        "maxActiveSubscriptions": {
          "const": 8
        },
        "maxQueueSize": {
          "const": 256
        },
        "maxDrainBatchSize": {
          "const": 128
        },
        "maxEventBytes": {
          "const": 4096
        },
        "maxTimeoutMs": {
          "const": 60000
        }
      }
    },
    "InputObserverKeyAction": {
      "enum": [
        "down",
        "up"
      ]
    },
    "InputObserverSourceId": {
      "enum": [
        "fake",
        "accessibility"
      ]
    },
    "InputObserverKeyDescriptor": {
      "type": "object",
      "required": [
        "type",
        "keys"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "key"
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InputObserverKeyAction"
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "source": {
          "$ref": "#/$defs/InputObserverSourceId"
        },
        "intercept": {
          "const": false
        }
      }
    },
    "InputObserverOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxQueueSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "maxEvents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        }
      }
    },
    "InputObserverSubscriptionSnapshot": {
      "type": "object",
      "required": [
        "id",
        "type",
        "source",
        "keys",
        "actions",
        "ready",
        "closed",
        "createdAt",
        "droppedCount"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "const": "key"
        },
        "source": {
          "$ref": "#/$defs/InputObserverSourceId"
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InputObserverKeyAction"
          }
        },
        "ready": {
          "type": "boolean"
        },
        "closed": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0
        },
        "droppedCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "InputObserverKeyEvent": {
      "type": "object",
      "required": [
        "type",
        "source",
        "key",
        "keyCode",
        "action",
        "eventTime",
        "repeatCount"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "key"
        },
        "source": {
          "$ref": "#/$defs/InputObserverSourceId"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "keyCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "action": {
          "$ref": "#/$defs/InputObserverKeyAction"
        },
        "eventTime": {
          "type": "integer",
          "minimum": 0
        },
        "repeatCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        }
      }
    },
    "InputObserverSource": {
      "type": "object",
      "required": [
        "id",
        "type",
        "available",
        "live"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/InputObserverSourceId"
        },
        "type": {
          "const": "key"
        },
        "available": {
          "type": "boolean"
        },
        "live": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "ObserveKeysMethod": {
      "type": "object",
      "required": [
        "requiredCapabilities",
        "request",
        "response"
      ],
      "additionalProperties": false,
      "properties": {
        "requiredCapabilities": {
          "const": [
            "input_observer",
            "input_observer.keys"
          ]
        },
        "request": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/InputObserverKeyDescriptor"
            },
            {
              "$ref": "#/$defs/InputObserverOptions"
            }
          ],
          "minItems": 1,
          "maxItems": 2
        },
        "response": {
          "$ref": "#/$defs/InputObserverSubscriptionSnapshot"
        }
      }
    },
    "DrainEventsMethod": {
      "type": "object",
      "required": [
        "requiredCapabilities",
        "request",
        "response"
      ],
      "additionalProperties": false,
      "properties": {
        "requiredCapabilities": {
          "const": [
            "input_observer",
            "input_observer.keys"
          ]
        },
        "request": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "$ref": "#/$defs/InputObserverOptions"
            }
          ],
          "minItems": 1,
          "maxItems": 2
        },
        "response": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InputObserverKeyEvent"
          },
          "maxItems": 128
        }
      }
    },
    "CloseMethod": {
      "type": "object",
      "required": [
        "requiredCapabilities",
        "request",
        "response"
      ],
      "additionalProperties": false,
      "properties": {
        "requiredCapabilities": {
          "const": [
            "input_observer",
            "input_observer.keys"
          ]
        },
        "request": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "$ref": "#/$defs/InputObserverOptions"
            }
          ],
          "minItems": 1,
          "maxItems": 2
        },
        "response": {
          "type": "boolean"
        }
      }
    },
    "GetAvailableSourcesMethod": {
      "type": "object",
      "required": [
        "requiredCapabilities",
        "request",
        "response"
      ],
      "additionalProperties": false,
      "properties": {
        "requiredCapabilities": {
          "const": [
            "input_observer"
          ]
        },
        "request": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InputObserverOptions"
          },
          "maxItems": 1
        },
        "response": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InputObserverSource"
          }
        }
      }
    }
  },
  "examples": [
    {
      "schema": "autojs6-node-input-observer-provider-v1",
      "module": "input_observer",
      "capabilities": [
        "input_observer",
        "input_observer.keys",
        "input_observer.touch",
        "input_observer.intercept"
      ],
      "limits": {
        "maxActiveSubscriptions": 8,
        "maxQueueSize": 256,
        "maxDrainBatchSize": 128,
        "maxEventBytes": 4096,
        "maxTimeoutMs": 60000
      },
      "methods": {
        "observeKeys": {
          "requiredCapabilities": [
            "input_observer",
            "input_observer.keys"
          ],
          "request": [
            {
              "type": "key",
              "keys": [
                "volume_up"
              ],
              "actions": [
                "down"
              ],
              "source": "fake",
              "intercept": false
            },
            {
              "maxQueueSize": 64,
              "timeoutMs": 10000
            }
          ],
          "response": {
            "id": "input-observer-1",
            "type": "key",
            "source": "fake",
            "keys": [
              "volume_up"
            ],
            "actions": [
              "down"
            ],
            "ready": true,
            "closed": false,
            "createdAt": 123456789,
            "droppedCount": 0
          }
        },
        "drainEvents": {
          "requiredCapabilities": [
            "input_observer",
            "input_observer.keys"
          ],
          "request": [
            "input-observer-1",
            {
              "maxEvents": 32,
              "timeoutMs": 1000
            }
          ],
          "response": [
            {
              "type": "key",
              "source": "fake",
              "key": "volume_up",
              "keyCode": 24,
              "action": "down",
              "eventTime": 123456789,
              "repeatCount": 0
            }
          ]
        },
        "close": {
          "requiredCapabilities": [
            "input_observer",
            "input_observer.keys"
          ],
          "request": [
            "input-observer-1"
          ],
          "response": true
        },
        "getAvailableSources": {
          "requiredCapabilities": [
            "input_observer"
          ],
          "request": [],
          "response": [
            {
              "id": "fake",
              "type": "key",
              "available": true,
              "live": false
            }
          ]
        }
      }
    }
  ]
}
