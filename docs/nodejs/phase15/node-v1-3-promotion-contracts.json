{
  "schema": "autojs6-node-phase15-promotion-contracts-v1",
  "phase": "Phase 15: Node v1.3 Provider Promotion",
  "task": "P15-02",
  "updatedAt": "2026-07-02",
  "branch": "feature/nodejs-runtime-v1.3",
  "promotionStateVocabulary": [
    {
      "id": "promoted",
      "meaning": "Available only through an explicit v1.3 Pro or Desktop opt-in profile, never through Safe by default.",
      "releaseUse": "Allowed only after implementation, connected device evidence, packaged APK behavior, disclosure, rollback, security, TypeScript, docs, Safe downgrade, and raw-object denial evidence all pass."
    },
    {
      "id": "provider_poc",
      "meaning": "Provider contract or proof exists, but user-facing opt-in promotion is not granted.",
      "releaseUse": "Visible in reports and docs as not promoted until every v1.3 promotion bar passes."
    },
    {
      "id": "future_only",
      "meaning": "Tracked as future promotion work and excluded from current release-blocking counts.",
      "releaseUse": "May appear in the Phase 15 summary and next backlog without changing runtime authority."
    },
    {
      "id": "stable_denied",
      "meaning": "Authority remains intentionally denied with stable diagnostics and regression coverage.",
      "releaseUse": "Acceptable v1.3 state when promotion would overclaim device, privacy, or packaged behavior."
    },
    {
      "id": "rejected",
      "meaning": "Authority is intentionally unavailable and should not be reopened without a new design record.",
      "releaseUse": "Must keep stable denial docs, tests, and migration guidance."
    }
  ],
  "optInPromotionRequiredEvidence": [
    "implementation_gate",
    "connected_device_evidence",
    "packaged_apk_evidence",
    "user_visible_disclosure",
    "rollback_disable_path",
    "security_regression_corpus",
    "typescript_declaration_profile",
    "migration_compat_release_docs",
    "safe_downgrade_behavior",
    "raw_object_denial_regression"
  ],
  "stateTransitions": [
    {
      "from": "provider_poc",
      "to": "promoted",
      "allowedWhen": "all optInPromotionRequiredEvidence entries are present and every provider-specific gate reports ready or passed"
    },
    {
      "from": "future_only",
      "to": "provider_poc",
      "allowedWhen": "implementation and host contracts exist but connected device, packaged, security, or docs evidence is still incomplete"
    },
    {
      "from": "stable_denied",
      "to": "provider_poc",
      "allowedWhen": "a new scoped provider design replaces the denial and raw Android object parity remains rejected"
    },
    {
      "from": "rejected",
      "to": "provider_poc",
      "allowedWhen": "a future phase explicitly reopens the design with security and migration approval"
    }
  ],
